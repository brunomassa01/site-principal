# ─────────── Banco de dados (Neon / Postgres) ───────────
# String "pooled" (host com "-pooler") — usada pelo app em produção
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require"
# String "direct/unpooled" (host SEM "-pooler") — usada só para migrations
DATABASE_URL_UNPOOLED="postgresql://USUARIO:SENHA@ep-xxxx.REGIAO.aws.neon.tech/neondb?sslmode=require"

# Segredo para sessões de login do Painel (string longa e aleatória)
SESSION_SECRET="troque-por-uma-string-longa-e-aleatoria"

# ─────────── TinaCMS (legado — será removido na Fase 4) ───────────
TINA_CLIENT_ID=
TINA_TOKEN=
