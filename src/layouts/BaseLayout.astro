---
import '../styles/global.css';
import { getIdentidade } from '../lib/content/collections';

interface Props {
  title: string;
  descricao?: string;
  imagem?: string;
  tipo?: string;
}

const id = (await getIdentidade()).data;
const { title, descricao = id?.descricao_meta ?? 'Currículo vivo do Bruno Massa — trajetória profissional em tempo real.', imagem, tipo = 'website' } = Astro.props;
const tituloCompleto = title === (id?.nome ?? 'Bruno Massa') ? title : `${title} — ${id?.nome ?? 'Bruno Massa'}`;
const rawOgImage = imagem ?? id?.og_image ?? '/images/bruno.jpg';
const ogImage = rawOgImage.startsWith('http') ? rawOgImage : `https://brunomassa.online${rawOgImage}`;
---
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descricao} />
    <meta name="generator" content={Astro.generator} />
    <title>{tituloCompleto}</title>
    <link rel="canonical" href={Astro.url.href} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:type" content={tipo} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={tituloCompleto} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloCompleto} />
    <meta name="twitter:description" content={descricao} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>
