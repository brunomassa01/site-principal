---
import '../styles/global.css';
import { getIdentidade } from '../lib/content/collections';
import { LOCALE, alternativas, localizar, semPrefixo, type Lang } from '../i18n';

interface Props {
  title: string;
  descricao?: string;
  imagem?: string;
  tipo?: string;
}

const lang: Lang = Astro.locals.lang ?? 'pt';
const id = (await getIdentidade(lang)).data;

const descricaoPadrao = lang === 'en'
  ? 'Bruno Massa — marketing, product and business. A living résumé, updated in real time.'
  : 'Currículo vivo do Bruno Massa — trajetória profissional em tempo real.';

const { title, descricao = id?.descricao_meta ?? descricaoPadrao, imagem, tipo = 'website' } = Astro.props;
const tituloCompleto = title === (id?.nome ?? 'Bruno Massa') ? title : `${title} — ${id?.nome ?? 'Bruno Massa'}`;
const rawOgImage = imagem ?? id?.og_image ?? '/images/bruno.jpg';
const ogImage = rawOgImage.startsWith('http') ? rawOgImage : `https://brunomassa.online${rawOgImage}`;

// SEO bilíngue: canônica do idioma atual + hreflang apontando para os dois.
const caminhoBase = semPrefixo(Astro.url.pathname);
const canonica = new URL(localizar(caminhoBase, lang), Astro.url.origin).href;
const alternates = alternativas(Astro.url.pathname, Astro.url.origin);
---
<!DOCTYPE html>
<html lang={LOCALE[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descricao} />
    <meta name="generator" content={Astro.generator} />
    <title>{tituloCompleto}</title>
    <link rel="canonical" href={canonica} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:type" content={tipo} />
    <meta property="og:url" content={canonica} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'pt_BR'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={tituloCompleto} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloCompleto} />
    <meta name="twitter:description" content={descricao} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>
