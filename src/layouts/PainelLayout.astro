---
import '../styles/global.css';

interface Props {
  titulo?: string;
}
const { titulo = 'Painel' } = Astro.props;
const user = Astro.locals.user;
const path = Astro.url.pathname;
const ativo = (href: string) =>
  href === '/painel' ? path === '/painel' : path.startsWith(href);

const nav = [
  { href: '/painel', label: 'Início' },
  { href: '/painel/posts', label: 'Blog' },
  { href: '/painel/timeline', label: 'Trajetória' },
  { href: '/painel/projetos', label: 'Projetos' },
  { href: '/painel/skills', label: 'Skills' },
  { href: '/painel/agora', label: 'Agora' },
  { href: '/painel/identidade', label: 'Identidade' },
  { href: '/painel/conta', label: 'Conta' },
];
---
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{titulo} · Painel</title>
  </head>
  <body class="bg-apple-fill min-h-screen">
    <header class="bg-white border-b border-apple-separator/40 sticky top-0 z-10">
      <div class="max-w-5xl mx-auto px-6 h-14 flex items-center justify-between">
        <div class="flex items-center gap-4">
          <a href="/painel" class="text-[15px] font-semibold text-apple-label">Painel</a>
          <nav class="flex items-center gap-1">
            {nav.map((l) => (
              <a
                href={l.href}
                class={`px-3 py-1.5 rounded-md text-[13px] transition-colors ${
                  ativo(l.href) ? 'text-apple-accent font-medium' : 'text-apple-secondary hover:text-apple-label'
                }`}
              >
                {l.label}
              </a>
            ))}
          </nav>
        </div>
        <div class="flex items-center gap-3">
          <a href="/" target="_blank" class="text-[13px] text-apple-secondary hover:text-apple-label">Ver site ↗</a>
          {user && <span class="text-[13px] text-apple-tertiary hidden sm:inline">{user.nome.split(' ')[0]}</span>}
          <button id="logout-btn" class="text-[13px] text-apple-secondary hover:text-red-600">Sair</button>
        </div>
      </div>
    </header>

    <main class="max-w-5xl mx-auto px-6 py-8">
      <slot />
    </main>

    <script>
      document.getElementById('logout-btn')?.addEventListener('click', async () => {
        await fetch('/api/painel/auth/logout', { method: 'POST' });
        window.location.href = '/painel/login';
      });
    </script>
  </body>
</html>
