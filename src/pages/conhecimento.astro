---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getConhecimento } from '../lib/content/conhecimento';

export const prerender = false;

const { fases, videos, referencias, artigos } = await getConhecimento();

const faseAtiva = fases.find((f) => f.status === 'em-curso') ?? fases[0] ?? null;
const progresso = faseAtiva?.progresso ?? 0;
const discAtiva = (faseAtiva?.disciplinas ?? []) as { nome: string; sub?: string }[];
const artigosDaFase = (n: number) => artigos.filter((a) => a.fase === n);

// constelação: nós a partir das disciplinas da fase ativa
const center = { x: 200, y: 200 };
const slots = [
  { x: 200, y: 64, a: 'middle', lx: 200, ly: 40 },
  { x: 326, y: 150, a: 'start', lx: 350, ly: 150 },
  { x: 280, y: 300, a: 'middle', lx: 280, ly: 332 },
  { x: 120, y: 300, a: 'middle', lx: 120, ly: 332 },
  { x: 74, y: 150, a: 'end', lx: 50, ly: 150 },
];
const nodes = discAtiva.slice(0, 5).map((d, i) => ({ ...slots[i], label: (d.nome || '').toUpperCase().slice(0, 9) }));
const hubEdges = nodes.map((n) => ({ x1: center.x, y1: center.y, x2: n.x, y2: n.y }));
const perimEdges = nodes.length > 1 ? nodes.map((n, i) => { const m = nodes[(i + 1) % nodes.length]; return { x1: n.x, y1: n.y, x2: m.x, y2: m.y }; }) : [];
const ringOff = Math.round(289 - (289 * progresso) / 100);

const tipoLabel: Record<string, string> = { livro: 'livro', artigo: 'artigo', filme: 'filme', doc: 'doc', ted: 'ted', video: 'vídeo' };
const fonteLabel: Record<string, string> = { fiap: 'gravado na FIAP', curadoria: 'curadoria', podcast: 'podcast', youtube: 'youtube' };
---
<BaseLayout title="Conhecimento Compartilhado" descricao="A jornada do MBA de Bruno Massa em IA para Negócios — aprender em voz alta: disciplinas, vídeos, referências e os artigos que escrevo a partir do que estudo.">
  <Header />
  <main class="kc">
    <div class="kc-wrap">

      <!-- HERO -->
      <section class="hero">
        <div class="txt">
          <div class="tag reveal">MBA 7IGETT · FIAP · IA para Negócios</div>
          <h1 class="reveal">Conhecimento<br><span class="c">Compartilhado</span></h1>
          <p class="reveal">Meu aprendizado tratado como um sistema: cada disciplina é um nó, cada conexão é um tema, cada conteúdo é uma saída. O que entendo de verdade, eu escrevo — e publico.</p>
          <div class="stats reveal">
            <span class="chip"><b>{discAtiva.length}</b> disciplinas</span>
            <span class="chip"><b>{videos.length}</b> vídeos</span>
            <span class="chip"><b>{referencias.length}</b> referências</span>
            <span class="chip">embarque <b>jun/2026</b></span>
          </div>
        </div>
        <div class="grafo-box reveal">
          <svg viewBox="0 0 400 400" role="img" aria-label={`Constelação de disciplinas com progresso de ${progresso}%`}>
            {hubEdges.map((e, i) => (<line class="edge hub" x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} style={`animation-delay:${0.1 + i * 0.1}s`} />))}
            {perimEdges.map((e, i) => (<line class="edge" x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} style={`animation-delay:${0.6 + i * 0.1}s`} />))}
            {nodes.map((n) => (
              <g class="node on">
                <circle class="node-c" cx={n.x} cy={n.y} r="15" />
                <text class="node-l" x={n.lx} y={n.ly} text-anchor={n.a}>{n.label}</text>
              </g>
            ))}
            <circle class="ring-bg" cx="200" cy="200" r="46" />
            <circle class="ring-fg" cx="200" cy="200" r="46" style={`--off:${ringOff}`} />
            <text class="hub-pct" x="200" y="202" text-anchor="middle">{progresso}%</text>
            <text class="hub-lab" x="200" y="218" text-anchor="middle">{faseAtiva ? `FASE 0${faseAtiva.numero}` : 'MBA'}</text>
          </svg>
        </div>
      </section>

      <!-- TRAJETORIA -->
      <section class="sec" id="trajetoria">
        <div class="sec-cab"><div class="tit"><span class="tag">Trajetória</span><h2>{fases.length} fases · 10 meses</h2></div><span class="nota">// {faseAtiva ? `fase 0${faseAtiva.numero} em curso` : ''}</span></div>
        <div class="tiles">
          {fases.map((f) => (
            <div class={`tile ${f.status === 'em-curso' ? 'ativa' : f.status === 'concluida' ? 'feita' : 'lock'}`}>
              <div class="fn">F0{f.numero}</div>
              <div class="fs">{f.titulo}</div>
              <div class="est">{f.status === 'em-curso' ? 'em curso' : f.status === 'concluida' ? 'concluída' : 'bloqueada'}</div>
            </div>
          ))}
        </div>

        {faseAtiva && (
          <div class="grid2" style="margin-top:18px">
            <div class="painel">
              <h3>Fase 0{faseAtiva.numero} · Disciplinas (nós do sistema)</h3>
              {discAtiva.length === 0 ? (<p class="vazio">Disciplinas em breve.</p>) : discAtiva.map((d, i) => (
                <div class="row"><span class="ix">0{i + 1}</span><span class="nm">{d.nome}{d.sub && <small>{d.sub}</small>}</span></div>
              ))}
            </div>
            <div class="painel">
              <h3>Saídas · Conteúdos</h3>
              {artigosDaFase(faseAtiva.numero).length === 0
                ? (<p class="vazio">Nenhum artigo publicado ainda — em produção.</p>)
                : artigosDaFase(faseAtiva.numero).map((a) => (
                    <a href={`/posts/${a.slug}`} class="row"><span class="nm">{a.titulo}</span><span class="badge">ler ↗</span></a>
                  ))}
            </div>
          </div>
        )}
      </section>

      <!-- VIDEOS -->
      <section class="sec" id="videos">
        <div class="sec-cab"><div class="tit"><span class="tag">Vídeos</span><h2>Gravados na FIAP + curadoria</h2></div><span class="nota">// {videos.length} {videos.length === 1 ? 'item' : 'itens'}</span></div>
        {videos.length === 0 ? (
          <div class="placeholder">Os primeiros vídeos chegam em breve — gravo na FIAP e curo por aqui.</div>
        ) : (
          <div class="galeria">
            {videos.map((v) => (
              <a href={v.url} target="_blank" rel="noopener" class="vid reveal">
                <div class="thumb" style={v.thumbnailUrl ? `background-image:url('${v.thumbnailUrl}');background-size:cover` : ''}>
                  <span class={`fonte ${v.fonte !== 'fiap' ? 'cur' : ''}`}>{fonteLabel[v.fonte] ?? v.fonte}</span>
                  <span class="play"></span>
                  {v.duracao && <span class="dur">{v.duracao}</span>}
                </div>
                <div class="vmeta"><div class="vt">{v.titulo}</div>{v.autor && <div class="vs">{v.autor}</div>}</div>
              </a>
            ))}
          </div>
        )}
      </section>

      <!-- REFERENCIAS -->
      <section class="sec" id="referencias">
        <div class="sec-cab"><div class="tit"><span class="tag">Referências</span><h2>O que me ajudou a entender</h2></div><span class="nota">// 🇬🇧 = leitura em inglês</span></div>
        {referencias.length === 0 ? (
          <div class="placeholder">As referências (livros, artigos, filmes, vídeos) aparecem aqui conforme eu avanço.</div>
        ) : (
          <>
            <div class="filtros" id="filtros">
              <span class="fchip on" data-f="todos">todos</span>
              <span class="fchip" data-f="livro">livros</span>
              <span class="fchip" data-f="artigo">artigos</span>
              <span class="fchip" data-f="filme">filmes</span>
              <span class="fchip" data-f="video">vídeos / ted</span>
            </div>
            <div class="refs" id="refs">
              {referencias.map((r) => (
                <div class="ref" data-tipo={['filme', 'doc'].includes(r.tipo) ? 'filme' : ['ted', 'video'].includes(r.tipo) ? 'video' : r.tipo}>
                  <div class="rt"><span class="rtipo">{tipoLabel[r.tipo] ?? r.tipo}</span>{r.idioma === 'en' && <span class="flag">🇬🇧</span>}</div>
                  <div class="rnome">{r.titulo}</div>
                  {r.fonte && <div class="rfonte">{r.fonte}</div>}
                  {r.url && <a class="rlink" href={r.url} target="_blank" rel="noopener">abrir ↗</a>}
                </div>
              ))}
            </div>
          </>
        )}
      </section>

      <footer class="kc-foot">
        <div class="mono">CURRÍCULO_VIVO · <b>BRUNO MASSA</b> · o tradutor do marketing<br>material oficial FIAP = privado · este painel = o que tornei público</div>
      </footer>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap');

  .kc{
    --base:#F4F7FB; --painel:#FFFFFF; --tinta:#0E1320; --mut:#69748A; --mut-2:#A6AEBD;
    --linha:#E2E8F1; --sinal:#3B6EF6; --sinal-2:#7CA0FF; --sinal-soft:rgba(59,110,246,.10);
    --ok:#15A07A; --sombra:0 1px 2px rgba(14,19,32,.04), 0 14px 40px rgba(20,40,90,.07);
    --sans:'IBM Plex Sans',system-ui,sans-serif; --mono:'IBM Plex Mono',ui-monospace,monospace;
    position:relative; background:var(--base); color:var(--tinta); font-family:var(--sans); line-height:1.6; overflow:hidden;
  }
  .kc::before{content:"";position:absolute;inset:0;z-index:0;pointer-events:none;
    background-image:linear-gradient(var(--linha) 1px,transparent 1px),linear-gradient(90deg,var(--linha) 1px,transparent 1px);
    background-size:34px 34px;opacity:.5;-webkit-mask-image:radial-gradient(1200px 700px at 70% 0%,#000,transparent 75%);mask-image:radial-gradient(1200px 700px at 70% 0%,#000,transparent 75%);}
  .kc::after{content:"";position:absolute;inset:0;z-index:0;pointer-events:none;background:radial-gradient(900px 540px at 78% -2%,var(--sinal-soft),transparent 60%)}
  .kc-wrap{position:relative;z-index:1;max-width:1120px;margin:0 auto;padding:0 clamp(18px,4vw,44px)}
  .kc .tag{font-family:var(--mono);font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--mut)}

  .hero{display:grid;grid-template-columns:1.05fr .95fr;gap:40px;align-items:center;padding:56px 0 50px}
  .hero .tag{margin-bottom:20px}
  .hero h1{font-weight:600;font-size:clamp(38px,6.4vw,62px);line-height:1.02;letter-spacing:-.025em;color:var(--tinta)}
  .hero h1 .c{color:var(--sinal)}
  .hero p{margin-top:22px;max-width:480px;color:#3c4660;font-size:clamp(15px,2vw,18px)}
  .hero .stats{margin-top:28px;display:flex;gap:10px;flex-wrap:wrap}
  .chip{font-family:var(--mono);font-size:11.5px;padding:8px 13px;border:1px solid var(--linha);border-radius:9px;background:var(--painel);color:var(--mut)}
  .chip b{color:var(--tinta);font-weight:500}
  @media(max-width:860px){.hero{grid-template-columns:1fr;gap:24px;padding:34px 0 36px}.grafo-box{order:-1;margin:0 auto}}

  .grafo-box{position:relative;aspect-ratio:1;max-width:400px;width:100%;margin-left:auto}
  .grafo-box svg{width:100%;height:auto;display:block;overflow:visible}
  .edge{stroke:var(--mut-2);stroke-width:1;opacity:.5;stroke-dasharray:260;stroke-dashoffset:260;animation:kc-traca 1.2s ease forwards}
  .edge.hub{stroke:var(--sinal-2);opacity:.7}
  .node-c{fill:var(--painel);stroke:var(--sinal);stroke-width:1.5;filter:drop-shadow(0 0 8px rgba(59,110,246,.5))}
  .node-l{font-family:var(--mono);font-size:9.5px;fill:var(--tinta);letter-spacing:.04em}
  .ring-bg{fill:none;stroke:var(--linha);stroke-width:6}
  .ring-fg{fill:none;stroke:var(--sinal);stroke-width:6;stroke-linecap:round;transform:rotate(-90deg);transform-origin:center;stroke-dasharray:289;stroke-dashoffset:289;animation:kc-anel 1.6s .5s cubic-bezier(.2,.7,.2,1) forwards}
  .hub-pct{font-family:var(--mono);font-size:19px;font-weight:500;fill:var(--tinta)}
  .hub-lab{font-family:var(--mono);font-size:8px;fill:var(--mut);letter-spacing:.14em}
  @keyframes kc-traca{to{stroke-dashoffset:0}}
  @keyframes kc-anel{to{stroke-dashoffset:var(--off)}}

  .sec{padding:34px 0;position:relative}
  .sec-cab{display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin-bottom:20px;flex-wrap:wrap}
  .sec-cab .tit{display:flex;align-items:center;gap:10px}
  .sec-cab .tit .tag::before{content:"▚ "}
  .sec-cab h2{font-size:clamp(19px,2.6vw,24px);font-weight:600;letter-spacing:-.01em;color:var(--tinta)}
  .sec-cab .nota{font-family:var(--mono);font-size:11px;color:var(--mut-2)}

  .tiles{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}
  @media(max-width:720px){.tiles{grid-template-columns:repeat(2,1fr)}}
  .tile{background:var(--painel);border:1px solid var(--linha);border-radius:12px;padding:16px;box-shadow:var(--sombra)}
  .tile .fn{font-family:var(--mono);font-size:11px;color:var(--mut)}
  .tile .fs{font-weight:600;font-size:14px;margin-top:8px;line-height:1.25;color:var(--tinta)}
  .tile .est{margin-top:12px;font-family:var(--mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;display:inline-flex;align-items:center;gap:6px;color:var(--mut)}
  .tile.ativa{border-color:var(--sinal);box-shadow:0 0 0 3px var(--sinal-soft),var(--sombra)}
  .tile.ativa .est{color:var(--sinal)}
  .tile.ativa .est::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--sinal);box-shadow:0 0 8px var(--sinal)}
  .tile.feita{border-color:var(--ok)}
  .tile.lock{opacity:.7;border-style:dashed;background:rgba(255,255,255,.5);box-shadow:none}

  .grid2{display:grid;grid-template-columns:1.1fr .9fr;gap:18px}
  @media(max-width:860px){.grid2{grid-template-columns:1fr}}
  .painel{background:var(--painel);border:1px solid var(--linha);border-radius:14px;box-shadow:var(--sombra);padding:22px clamp(18px,2.5vw,26px)}
  .painel h3{font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--mut);font-weight:500;margin-bottom:16px}
  .row{display:flex;align-items:baseline;gap:12px;padding:11px 0;border-bottom:1px solid var(--linha);text-decoration:none;color:inherit}
  .row:last-child{border-bottom:none}
  .row .ix{font-family:var(--mono);font-size:11px;color:var(--sinal);min-width:22px}
  .row .nm{font-weight:500;font-size:14.5px;color:var(--tinta)}
  .row .nm small{display:block;color:var(--mut);font-weight:400;font-size:12.5px}
  .row .badge{margin-left:auto;font-family:var(--mono);font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--mut-2)}
  a.row:hover .nm{color:var(--sinal)}
  .vazio{color:var(--mut);font-size:14px}
  .placeholder{background:var(--painel);border:1px dashed var(--mut-2);border-radius:14px;padding:28px;text-align:center;color:var(--mut);font-size:14.5px}

  .galeria{display:grid;grid-template-columns:repeat(auto-fill,minmax(258px,1fr));gap:16px}
  .vid{background:var(--painel);border:1px solid var(--linha);border-radius:14px;overflow:hidden;box-shadow:var(--sombra);text-decoration:none;color:inherit;transition:transform .2s,box-shadow .2s}
  .vid:hover{transform:translateY(-3px);box-shadow:0 1px 2px rgba(14,19,32,.04),0 22px 50px rgba(20,40,90,.12)}
  .thumb{position:relative;aspect-ratio:16/9;background:radial-gradient(120px 80px at 70% 30%,rgba(124,160,255,.5),transparent 70%),linear-gradient(135deg,#11203f,#1d3a6b 60%,#2a5bb0);overflow:hidden}
  .thumb .play{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:46px;height:46px;border-radius:50%;background:rgba(255,255,255,.92);display:grid;place-items:center;box-shadow:0 6px 20px rgba(0,0,0,.3)}
  .thumb .play::after{content:"";border-left:13px solid var(--tinta);border-top:8px solid transparent;border-bottom:8px solid transparent;margin-left:3px}
  .thumb .dur{position:absolute;right:8px;bottom:8px;font-family:var(--mono);font-size:10.5px;color:#fff;background:rgba(0,0,0,.55);padding:3px 7px;border-radius:6px}
  .thumb .fonte{position:absolute;left:8px;top:8px;font-family:var(--mono);font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:#fff;background:rgba(59,110,246,.85);padding:4px 8px;border-radius:6px}
  .thumb .fonte.cur{background:rgba(0,0,0,.5)}
  .vid .vmeta{padding:14px 16px 16px}
  .vid .vt{font-weight:600;font-size:14.5px;line-height:1.35;color:var(--tinta)}
  .vid .vs{margin-top:8px;font-family:var(--mono);font-size:11px;color:var(--mut)}

  .filtros{display:flex;gap:8px;flex-wrap:wrap}
  .fchip{font-family:var(--mono);font-size:11px;letter-spacing:.06em;padding:7px 13px;border:1px solid var(--linha);border-radius:999px;background:var(--painel);color:var(--mut);cursor:pointer;transition:.15s}
  .fchip:hover{border-color:var(--sinal-2);color:var(--tinta)}
  .fchip.on{background:var(--sinal);border-color:var(--sinal);color:#fff}
  .refs{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px;margin-top:18px}
  .ref{background:var(--painel);border:1px solid var(--linha);border-radius:13px;padding:18px;box-shadow:var(--sombra);display:flex;flex-direction:column;gap:8px}
  .ref:hover{border-color:var(--sinal-2)}
  .ref .rt{display:flex;align-items:center;gap:8px}
  .ref .rtipo{font-family:var(--mono);font-size:9.5px;letter-spacing:.12em;text-transform:uppercase;padding:4px 8px;border-radius:6px;background:var(--sinal-soft);color:var(--sinal)}
  .ref .flag{font-size:12px}
  .ref .rnome{font-weight:600;font-size:15px;line-height:1.3;color:var(--tinta)}
  .ref .rfonte{font-size:13px;color:var(--mut)}
  .ref .rlink{margin-top:auto;font-family:var(--mono);font-size:11px;color:var(--sinal);text-decoration:none}

  .kc-foot{padding:54px 0 70px;text-align:center}
  .kc-foot .mono{font-family:var(--mono);font-size:11.5px;color:var(--mut);line-height:1.9}
  .kc-foot .mono b{color:var(--tinta);font-weight:500}

  .reveal{opacity:0;transform:translateY(20px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.2,1)}
  .reveal.on{opacity:1;transform:none}
  @media(prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none;transition:none}.edge,.ring-fg{animation:none;stroke-dashoffset:0}.ring-fg{stroke-dashoffset:var(--off)}}
</style>

<script>
  const io = new IntersectionObserver((es) => {
    es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('on'); io.unobserve(e.target); } });
  }, { threshold: 0.1, rootMargin: '0px 0px -6% 0px' });
  document.querySelectorAll('.kc .reveal').forEach((el, i) => { (el as HTMLElement).style.transitionDelay = Math.min(i, 5) * 45 + 'ms'; io.observe(el); });

  const chips = document.querySelectorAll<HTMLElement>('#filtros .fchip');
  const refs = document.querySelectorAll<HTMLElement>('#refs .ref');
  chips.forEach((c) => c.addEventListener('click', () => {
    chips.forEach((x) => x.classList.remove('on'));
    c.classList.add('on');
    const f = c.dataset.f;
    refs.forEach((r) => { r.style.display = f === 'todos' || r.dataset.tipo === f ? '' : 'none'; });
  }));
</script>
