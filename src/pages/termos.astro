---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getIdentidade } from '../lib/content/collections';
import { legal, comEmail } from '../i18n/legal';
import type { Lang } from '../i18n';

export const prerender = false;

const lang: Lang = Astro.locals.lang ?? 'pt';
const id = (await getIdentidade(lang)).data;
const email = id.email || 'contato@brunomassa.online';

const doc = legal[lang].termos;
const corpo = comEmail(doc.html, email);
---
<BaseLayout title={doc.titulo} descricao={legal[lang].metaTermos}>
  <Header />
  <main class="max-w-[760px] mx-auto px-5 py-12">
    <h1 class="text-[28px] font-bold text-apple-label tracking-tight mb-1">{doc.titulo}</h1>
    <p class="text-[13px] text-apple-tertiary mb-8">{doc.atualizadoRotulo} {doc.atualizado}</p>

    {doc.aviso && (
      <p
        class="mb-8 px-4 py-3 rounded-xl bg-apple-fill border border-apple-separator-light text-[13px] text-apple-secondary [&_a]:text-apple-accent [&_a]:underline"
        set:html={doc.aviso}
      />
    )}

    <div
      class="space-y-6 text-[15px] leading-relaxed text-apple-secondary [&_h2]:text-[18px] [&_h2]:font-semibold [&_h2]:text-apple-label [&_h2]:mt-8 [&_h2]:mb-2 [&_a]:text-apple-accent [&_a]:underline [&_strong]:text-apple-label"
      set:html={corpo}
    />
  </main>
  <Footer />
</BaseLayout>
