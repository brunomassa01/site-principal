---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getIdentidade } from '../lib/content/collections';
export const prerender = false;
const id = (await getIdentidade()).data;
---
<BaseLayout title="Contato" descricao="Entre em contato com Bruno Massa.">
  <Header />
  <main>
    <!-- Page header -->
    <section class="bg-white py-16 md:py-20">
      <div class="max-w-3xl mx-auto px-6">
        <div class="flex flex-col sm:flex-row sm:items-center sm:gap-8 mb-2">
          <div class="flex-none mb-6 sm:mb-0">
            <div class="w-20 h-20 rounded-2xl overflow-hidden shadow-card">
              <img src="/images/bruno.jpg" alt="Bruno Massa" class="w-full h-full object-cover object-top" />
            </div>
          </div>
          <div>
            <p class="text-[12px] font-semibold uppercase tracking-[0.08em] text-apple-accent mb-3">Contato</p>
            <h1 class="text-4xl md:text-5xl font-bold text-apple-label tracking-tight leading-tight mb-3">
              Vamos conversar
            </h1>
            <p class="text-[17px] text-apple-secondary max-w-xl leading-relaxed">
              Aberto a projetos, oportunidades e boas conversas sobre marketing, produto e negócios.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact options -->
    <section class="py-12">
      <div class="max-w-3xl mx-auto px-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {id.email && (
            <a
              href={`mailto:${id.email}`}
              class="group bg-apple-surface rounded-2xl shadow-card p-6 transition-all duration-300 hover:shadow-card-hover hover:-translate-y-0.5"
            >
              <p class="text-[12px] font-semibold uppercase tracking-[0.08em] text-apple-tertiary mb-3">E-mail</p>
              <p class="text-[20px] font-semibold text-apple-label tracking-tight mb-2 group-hover:text-apple-accent transition-colors">
                {id.email}
              </p>
              <p class="text-[14px] text-apple-secondary">Respondo em até 24h em dias úteis.</p>
            </a>
          )}

          {id.linkedin_url && (
            <a
              href={id.linkedin_url}
              target="_blank"
              rel="noopener"
              class="group bg-apple-surface rounded-2xl shadow-card p-6 transition-all duration-300 hover:shadow-card-hover hover:-translate-y-0.5"
            >
              <p class="text-[12px] font-semibold uppercase tracking-[0.08em] text-apple-tertiary mb-3">LinkedIn</p>
              <p class="text-[20px] font-semibold text-apple-label tracking-tight mb-2 group-hover:text-apple-accent transition-colors">
                {id.linkedin_url.replace('https://', '').replace('http://', '')} ↗
              </p>
              <p class="text-[14px] text-apple-secondary">Conecte-se ou envie uma mensagem direta.</p>
            </a>
          )}
        </div>

        <div class="mt-8 bg-apple-fill rounded-2xl p-6">
          <p class="text-[15px] text-apple-secondary leading-relaxed">
            Prefiro uma conversa direta sobre o que você tem em mente — seja uma oportunidade de trabalho,
            uma parceria em projeto ou uma troca de ideias. Sem formulários, sem burocracia.
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
