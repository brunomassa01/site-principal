---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getProjetoBySlug } from '../../lib/content/collections';
import { renderBody } from '../../lib/content/render';

export const prerender = false;

const { slug } = Astro.params;
const projeto = slug ? await getProjetoBySlug(slug) : null;
if (!projeto) return Astro.redirect('/projetos');
const d = projeto.data;

const statusLabel: Record<string, string> = {
  'em-andamento': 'Em andamento',
  'concluido': 'Concluído',
  'em-pausa': 'Em pausa',
  'arquivado': 'Arquivado',
};

const badgeClass: Record<string, string> = {
  'em-andamento': 'bg-green-50 text-green-700 border-green-200',
  'concluido': 'bg-blue-50 text-blue-600 border-blue-200',
  'em-pausa': 'bg-yellow-50 text-yellow-700 border-yellow-200',
  'arquivado': 'bg-gray-50 text-gray-500 border-gray-200',
};

const fmt = (date: Date) => date.toLocaleDateString('pt-BR', { month: 'short', year: 'numeric' });
---
<BaseLayout title={d.titulo} descricao={d.resumo}>
  <Header />
  <main>
    <!-- Header -->
    <section class="bg-white py-16 md:py-20">
      <div class="max-w-3xl mx-auto px-6">
        <a href="/projetos" class="inline-flex items-center gap-1.5 text-[13px] text-apple-secondary hover:text-apple-label transition-colors mb-8">
          ← Projetos
        </a>

        <div class="flex flex-wrap items-center gap-2 mb-4">
          <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold border ${badgeClass[d.status]}`}>
            {statusLabel[d.status]}
          </span>
          {d.destaque && (
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-apple-accent/10 text-apple-accent border border-apple-accent/20">
              Destaque
            </span>
          )}
        </div>

        <h1 class="text-4xl md:text-5xl font-bold text-apple-label tracking-tight leading-tight mb-3 text-balance">
          {d.titulo}
        </h1>
        {d.subtitulo && (
          <p class="text-[20px] text-apple-secondary font-normal leading-snug mb-4">{d.subtitulo}</p>
        )}

        <!-- Meta row -->
        <div class="flex flex-wrap gap-x-6 gap-y-2 mt-6 pt-6 border-t border-apple-separator-light text-[14px] text-apple-secondary">
          {d.papel && (
            <div>
              <span class="text-[11px] font-semibold uppercase tracking-wider text-apple-tertiary block mb-0.5">Papel</span>
              <span>{d.papel}</span>
            </div>
          )}
          {d.cliente && (
            <div>
              <span class="text-[11px] font-semibold uppercase tracking-wider text-apple-tertiary block mb-0.5">Cliente</span>
              <span>{d.cliente}</span>
            </div>
          )}
          <div>
            <span class="text-[11px] font-semibold uppercase tracking-wider text-apple-tertiary block mb-0.5">Período</span>
            <span>
              <time>{fmt(d.inicio)}</time>
              {' – '}
              <time>{d.fim ? fmt(d.fim) : 'Em andamento'}</time>
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- Content -->
    <section class="py-12">
      <div class="max-w-3xl mx-auto px-6">
        <!-- Resumo -->
        <div class="bg-apple-surface rounded-2xl shadow-card p-6 mb-8">
          <p class="text-[12px] font-semibold uppercase tracking-[0.08em] text-apple-accent mb-2">Resumo</p>
          <p class="text-[17px] text-apple-label leading-relaxed">{d.resumo}</p>
        </div>

        <!-- Problema / Abordagem / Resultado -->
        {(d.problema || d.abordagem || d.resultado) && (
          <div class="grid grid-cols-1 gap-4 mb-8">
            {d.problema && (
              <div class="bg-apple-fill rounded-2xl p-6">
                <p class="text-[12px] font-semibold uppercase tracking-[0.08em] text-apple-tertiary mb-2">Problema</p>
                <p class="text-[15px] text-apple-secondary leading-relaxed">{d.problema}</p>
              </div>
            )}
            {d.abordagem && (
              <div class="bg-apple-fill rounded-2xl p-6">
                <p class="text-[12px] font-semibold uppercase tracking-[0.08em] text-apple-tertiary mb-2">Abordagem</p>
                <p class="text-[15px] text-apple-secondary leading-relaxed">{d.abordagem}</p>
              </div>
            )}
            {d.resultado && (
              <div class="bg-apple-surface rounded-2xl shadow-card p-6 border border-apple-accent/10">
                <p class="text-[12px] font-semibold uppercase tracking-[0.08em] text-apple-accent mb-2">Resultado</p>
                <p class="text-[15px] text-apple-secondary leading-relaxed">{d.resultado}</p>
              </div>
            )}
          </div>
        )}

        <!-- Corpo (texto rico do Painel) -->
        {projeto.bodyHtml && (
          <div class="prose-content mb-8" set:html={renderBody(projeto.bodyHtml)} />
        )}

        <!-- Links -->
        {(d.link || d.repo) && (
          <div class="flex flex-wrap gap-3 mb-8">
            {d.link && (
              <a
                href={d.link}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 px-5 py-2.5 bg-apple-accent text-white rounded-full text-[14px] font-medium hover:bg-apple-accent-dark transition-colors"
              >
                Acessar projeto ↗
              </a>
            )}
            {d.repo && (
              <a
                href={d.repo}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 px-5 py-2.5 bg-apple-fill text-apple-label rounded-full text-[14px] font-medium hover:bg-apple-separator-light transition-colors"
              >
                Repositório ↗
              </a>
            )}
          </div>
        )}

        <!-- Tags -->
        {d.tags && d.tags.length > 0 && (
          <div class="pt-6 border-t border-apple-separator-light">
            <p class="text-[12px] font-semibold uppercase tracking-[0.06em] text-apple-tertiary mb-3">Tags</p>
            <div class="flex flex-wrap gap-2">
              {d.tags.map((tag) => (
                <span class="px-3 py-1 rounded-full text-[12px] font-medium bg-apple-fill text-apple-secondary border border-apple-separator-light">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
