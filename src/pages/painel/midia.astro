---
import PainelLayout from '../../layouts/PainelLayout.astro';
import MediaGrid from '../../components/painel/MediaGrid.tsx';
export const prerender = false;
---
<PainelLayout titulo="Mídia">
  <h1 class="text-[24px] font-bold text-apple-label tracking-tight mb-1">Mídia</h1>
  <p class="text-[14px] text-apple-secondary mb-6">Tudo que você sobe ou gera com IA fica aqui, pronto pra reusar. Copie o link pra usar em qualquer lugar, ou exclua.</p>
  <MediaGrid client:load />
</PainelLayout>
