---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const todas = await getCollection('agora');
const pagina = todas[0];
const Content = pagina ? (await pagina.render()).Content : null;

const dataAgora = pagina?.data.atualizado_em
  ? pagina.data.atualizado_em.toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric' })
  : null;

const agora_dt = new Date();
const posts = (await getCollection('posts', ({ data }) =>
  !data.rascunho && (!data.publicar_em || data.publicar_em <= agora_dt)
)).sort((a, b) => b.data.data.valueOf() - a.data.data.valueOf());

const fmtData = (d: Date) => d.toLocaleDateString('pt-BR', { day: 'numeric', month: 'short', year: 'numeric' });
---
<BaseLayout title="Agora" descricao="O que Bruno Massa está focando neste momento — e o que escreve sobre marketing, produto e negócios.">
  <Header />
  <main>

    <!-- Page header -->
    <section class="bg-white py-16 md:py-20">
      <div class="max-w-3xl mx-auto px-6">
        <p class="text-[12px] font-semibold uppercase tracking-[0.08em] text-apple-accent mb-4">Agora</p>
        <h1 class="text-4xl md:text-5xl font-bold text-apple-label tracking-tight leading-tight mb-4">
          O que estou fazendo
        </h1>
        <p class="text-[17px] text-apple-secondary leading-relaxed max-w-xl">
          Foco atual, publicações e anotações.
        </p>
      </div>
    </section>

    <!-- Posts (mais recentes primeiro) -->
    {posts.length > 0 && (
      <section class="pt-4 pb-12">
        <div class="max-w-3xl mx-auto px-6">
          <h2 class="text-[22px] font-bold text-apple-label tracking-tight mb-6">Publicações</h2>
          <div class="space-y-4">
            {posts.map((p) => (
              <a
                href={`/posts/${p.slug}`}
                class="group flex gap-5 bg-apple-surface rounded-2xl shadow-card overflow-hidden transition-all duration-300 hover:shadow-card-hover hover:-translate-y-0.5"
              >
                {p.data.capa_url && (
                  <div class="flex-none w-28 sm:w-36 bg-black overflow-hidden">
                    <img
                      src={p.data.capa_url}
                      alt=""
                      class="w-full h-full object-cover opacity-90 group-hover:opacity-100 transition-opacity"
                      aria-hidden="true"
                    />
                  </div>
                )}
                <div class={`flex flex-col justify-center py-5 pr-6 ${p.data.capa_url ? '' : 'pl-6'}`}>
                  <div class="flex flex-wrap items-center gap-2 mb-2">
                    <time class="text-[11px] font-semibold uppercase tracking-wide text-apple-tertiary">
                      {fmtData(p.data.data)}
                    </time>
                    {p.data.idioma === 'en' && (
                      <span class="px-2 py-0.5 rounded-full text-[10px] font-medium bg-apple-fill text-apple-tertiary">EN</span>
                    )}
                  </div>
                  <h3 class="text-[17px] font-bold text-apple-label tracking-tight leading-snug mb-2 group-hover:text-apple-accent transition-colors text-balance">
                    {p.data.titulo}
                  </h3>
                  <p class="text-[13px] text-apple-secondary leading-relaxed line-clamp-2 hidden sm:block">
                    {p.data.resumo}
                  </p>
                  {p.data.tags && p.data.tags.length > 0 && (
                    <div class="flex flex-wrap gap-1.5 mt-3">
                      {p.data.tags.slice(0, 3).map((tag) => (
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-medium bg-apple-fill text-apple-tertiary">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Conteúdo /agora -->
    {pagina && Content && (
      <section class="py-12 border-t border-apple-separator-light">
        <div class="max-w-3xl mx-auto px-6">
          <h2 class="text-[22px] font-bold text-apple-label tracking-tight mb-4">Momento atual</h2>
          {dataAgora && (
            <p class="text-[13px] text-apple-tertiary mb-4 flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-green-500 inline-block"></span>
              Atualizado em {dataAgora}
            </p>
          )}
          <article class="bg-apple-surface rounded-2xl shadow-card p-8 md:p-10">
            <div class="prose-content">
              <Content />
            </div>
          </article>
        </div>
      </section>
    )}

  </main>
  <Footer />
</BaseLayout>
