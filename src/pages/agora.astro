---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getPostsPublicados } from '../lib/content/posts';
import { getAgora } from '../lib/content/collections';
import { renderBody } from '../lib/content/render';
import { usarT, localizar, formatarData, LOCALE, type Lang } from '../i18n';

export const prerender = false;

const lang: Lang = Astro.locals.lang ?? 'pt';
const t = usarT(lang);
const lz = (href: string) => localizar(href, lang);

const pagina = await getAgora(lang);

const dataAgora = pagina?.data.atualizado_em ? formatarData(pagina.data.atualizado_em, lang) : null;

const posts = await getPostsPublicados(lang);

const fmtData = (d: Date) =>
  new Intl.DateTimeFormat(LOCALE[lang], { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(d);
---
<BaseLayout title={t('agora.titulo')} descricao={t('agoraPg.metaDesc')}>
  <Header />
  <main>

    <!-- Page header -->
    <section class="bg-white py-16 md:py-20">
      <div class="max-w-3xl mx-auto px-6">
        <p class="text-[12px] font-semibold uppercase tracking-[0.08em] text-apple-accent mb-4">{t('agora.titulo')}</p>
        <h1 class="text-4xl md:text-5xl font-bold text-apple-label tracking-tight leading-tight mb-4">
          {t('agoraPg.titulo')}
        </h1>
        <p class="text-[17px] text-apple-secondary leading-relaxed max-w-xl">
          {t('agoraPg.subtitulo')}
        </p>
      </div>
    </section>

    <!-- Posts (mais recentes primeiro) -->
    {posts.length > 0 && (
      <section class="pt-4 pb-12">
        <div class="max-w-3xl mx-auto px-6">
          <h2 class="text-[22px] font-bold text-apple-label tracking-tight mb-6">{t('agoraPg.publicacoes')}</h2>
          <div class="space-y-4">
            {posts.map((p) => (
              <a
                href={lz(`/posts/${p.slug}`)}
                class="group flex gap-5 bg-apple-surface rounded-2xl shadow-card overflow-hidden transition-all duration-300 hover:shadow-card-hover hover:-translate-y-0.5"
              >
                {p.data.capa_url && (
                  <div class="flex-none w-28 sm:w-36 bg-black overflow-hidden">
                    <img
                      src={p.data.capa_url}
                      alt=""
                      class="w-full h-full object-cover opacity-90 group-hover:opacity-100 transition-opacity"
                      aria-hidden="true"
                    />
                  </div>
                )}
                <div class={`flex flex-col justify-center py-5 pr-6 ${p.data.capa_url ? '' : 'pl-6'}`}>
                  <div class="flex flex-wrap items-center gap-2 mb-2">
                    <time class="text-[11px] font-semibold uppercase tracking-wide text-apple-tertiary">
                      {fmtData(p.data.data)}
                    </time>
                    {p.data.idioma_original === 'en' && lang === 'pt' && (
                      <span class="px-2 py-0.5 rounded-full text-[10px] font-medium bg-apple-fill text-apple-tertiary">EN</span>
                    )}
                  </div>
                  <h3 class="text-[17px] font-bold text-apple-label tracking-tight leading-snug mb-2 group-hover:text-apple-accent transition-colors text-balance">
                    {p.data.titulo}
                  </h3>
                  <p class="text-[13px] text-apple-secondary leading-relaxed line-clamp-2 hidden sm:block">
                    {p.data.resumo}
                  </p>
                  {p.data.tags && p.data.tags.length > 0 && (
                    <div class="flex flex-wrap gap-1.5 mt-3">
                      {p.data.tags.slice(0, 3).map((tag) => (
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-medium bg-apple-fill text-apple-tertiary">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Conteúdo /agora -->
    {pagina && pagina.bodyHtml && (
      <section class="py-12 border-t border-apple-separator-light">
        <div class="max-w-3xl mx-auto px-6">
          <h2 class="text-[22px] font-bold text-apple-label tracking-tight mb-4">{t('agoraPg.momento')}</h2>
          {dataAgora && (
            <p class="text-[13px] text-apple-tertiary mb-4 flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-green-500 inline-block"></span>
              {t('agoraPg.atualizado')} {dataAgora}
            </p>
          )}
          <article class="bg-apple-surface rounded-2xl shadow-card p-8 md:p-10">
            <div class="prose-content" set:html={renderBody(pagina.bodyHtml)} />
          </article>
        </div>
      </section>
    )}

  </main>
  <Footer />
</BaseLayout>
