---
export const prerender = false;

// LP do ebook "Marketing com Estrategia nao e discurso". Pagina do Bruno na
// identidade do site (design system apple-*: Inter, branco, azul #0071E3).
// So serve no subdominio lp., igual as demais landing pages.
const host = Astro.url.host;
const ehLp = host.startsWith('lp.') || Astro.url.searchParams.has('preview');
if (!ehLp) return new Response('Not Found', { status: 404 });

// CONFIGURACAO: link real do checkout Hotmart do ebook.
// checkoutMode=2 abre o popup embutido; sck=lp_ebook atribui a venda a esta LP.
// Vazio = rascunho: pagina noindex e botao de compra desligado.
const CHECKOUT_URL = 'https://pay.hotmart.com/D106924275J?checkoutMode=2&sck=lp_ebook';
const PUBLICADO = CHECKOUT_URL.length > 0;

const urlCanonica = 'https://lp.brunomassa.online/ebook';
const titulo = 'Marketing com Estrategia nao e discurso | Ebook de Bruno Massa';
const descricao =
  'Um metodo direto para transformar estrategia de palavra bonita em criterio de decisao na rotina de marketing. Ebook de Bruno Massa, Mente do Mercado. R$ 67.';
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{titulo}</title>
<meta name="description" content={descricao} />
{!PUBLICADO && <meta name="robots" content="noindex, nofollow" />}
<link rel="canonical" href={urlCanonica} />
<link rel="icon" type="image/png" href="/favicon.png" />
<meta property="og:title" content="Marketing com Estrategia nao e discurso" />
<meta property="og:description" content={descricao} />
<meta property="og:type" content="website" />
<meta property="og:url" content={urlCanonica} />
<link rel="stylesheet" href="https://static.hotmart.com/css/hotmart-fb.min.css" />
<script is:inline src="https://static.hotmart.com/checkout/widget.min.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<style is:global>
  :root{
    --bg:#ffffff;
    --fill:#f2f2f7;
    --surface:#ffffff;
    --label:#1d1d1f;
    --secondary:#6e6e73;
    --tertiary:#86868b;
    --accent:#0071e3;
    --accent-dark:#0077ed;
    --separator:#d2d2d7;
    --separator-light:#e8e8ed;
    --shadow-card:0 2px 20px rgba(0,0,0,.05);
    --shadow-hover:0 8px 40px rgba(0,0,0,.10);
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--bg);
    color:var(--label);
    font-family:'Inter',-apple-system,BlinkMacSystemFont,'Helvetica Neue',Arial,sans-serif;
    line-height:1.47;
    font-size:17px;
    -webkit-font-smoothing:antialiased;
  }
  .wrap{max-width:840px;margin:0 auto;padding:0 24px;}
  .eyebrow{
    font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;
    color:var(--accent);
  }
  header.hero{padding:88px 0 68px;}
  h1{
    font-size:clamp(38px,6vw,60px);
    line-height:1.05;font-weight:800;letter-spacing:-0.03em;
    margin:18px 0 22px;color:var(--label);
  }
  h1 em{font-style:normal;color:var(--tertiary);}
  .lede{font-size:clamp(19px,2.2vw,22px);color:var(--secondary);max-width:52ch;line-height:1.5;}
  h2{
    font-size:clamp(28px,4vw,38px);
    font-weight:700;line-height:1.1;letter-spacing:-0.02em;
    margin-bottom:20px;color:var(--label);
  }
  section{padding:72px 0;border-top:1px solid var(--separator-light);}
  .tint{background:var(--fill);}
  p{margin-bottom:16px;max-width:62ch;color:var(--secondary);font-size:17px;line-height:1.6;}
  .btn{
    display:inline-block;font-weight:600;font-size:16px;
    background:var(--accent);color:#fff;
    padding:14px 30px;border-radius:980px;
    text-decoration:none;border:none;cursor:pointer;
    transition:background .2s ease;
  }
  .btn:hover{background:var(--accent-dark);}
  .btn[aria-disabled="true"]{opacity:.4;cursor:not-allowed;}
  .micro{font-size:13px;color:var(--tertiary);margin-top:14px;}
  .cta-block{margin-top:30px;}
  .cols{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:12px;}
  @media(max-width:640px){.cols{grid-template-columns:1fr;}}
  .col-card{
    background:var(--surface);border:1px solid var(--separator);
    border-radius:18px;padding:28px;box-shadow:var(--shadow-card);
  }
  .col-card h3{
    font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;
    margin-bottom:16px;color:var(--accent);
  }
  ul.plain{list-style:none;}
  ul.plain li{
    padding:10px 0 10px 26px;position:relative;font-size:15.5px;color:var(--label);
    border-bottom:1px solid var(--separator-light);
  }
  ul.plain li:last-child{border-bottom:none;}
  ul.plain li::before{
    content:"";position:absolute;left:2px;top:18px;
    width:8px;height:8px;border-radius:2px;background:var(--accent);
  }
  .col-card.nao ul.plain li::before{background:var(--tertiary);}
  .price-box{
    background:var(--surface);border:1px solid var(--separator);
    border-radius:20px;padding:36px;text-align:center;
    max-width:440px;margin:28px auto 0;box-shadow:var(--shadow-card);
  }
  .price-box .valor{
    font-size:56px;line-height:1;margin:12px 0 6px;
    font-weight:800;letter-spacing:-0.03em;color:var(--label);
  }
  .price-box .valor small{font-size:22px;vertical-align:top;font-weight:600;color:var(--secondary);}
  details{border-bottom:1px solid var(--separator);padding:16px 0;}
  details summary{
    cursor:pointer;font-weight:600;font-size:16px;color:var(--label);
    list-style:none;position:relative;padding-right:28px;
  }
  details summary::-webkit-details-marker{display:none;}
  details summary::after{
    content:"+";position:absolute;right:4px;top:-2px;
    color:var(--accent);font-size:22px;font-weight:400;
  }
  details[open] summary::after{content:"\2013";}
  details p{margin-top:12px;font-size:15.5px;color:var(--secondary);}
  footer{
    padding:48px 0 120px;text-align:center;
    font-size:13px;color:var(--tertiary);border-top:1px solid var(--separator-light);
  }
  footer p{color:var(--tertiary);max-width:none;margin-bottom:6px;font-size:13px;}

  .rascunho-bar{
    background:var(--accent);color:#fff;text-align:center;
    font-size:12px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;padding:9px 16px;
  }

  /* ===== Chat widget ===== */
  #chat-toggle{
    position:fixed;right:20px;bottom:20px;z-index:60;
    font-size:14px;font-weight:600;
    background:var(--label);color:#fff;border:none;border-radius:980px;
    padding:14px 22px;cursor:pointer;box-shadow:0 6px 20px rgba(0,0,0,.18);
  }
  #chat-panel{
    position:fixed;right:20px;bottom:78px;z-index:60;
    width:min(360px,calc(100vw - 40px));
    background:var(--surface);border:1px solid var(--separator);border-radius:18px;
    box-shadow:0 12px 40px rgba(0,0,0,.18);
    display:none;flex-direction:column;overflow:hidden;
  }
  #chat-panel.open{display:flex;}
  #chat-head{
    background:var(--label);color:#fff;padding:15px 18px;
    font-size:14px;font-weight:600;display:flex;justify-content:space-between;align-items:center;
  }
  #chat-head button{background:none;border:none;color:#fff;font-size:18px;cursor:pointer;}
  #chat-log{padding:16px;overflow-y:auto;max-height:340px;font-size:14px;line-height:1.5;}
  .msg{margin-bottom:10px;max-width:92%;}
  .msg.bot{
    background:var(--fill);border-radius:14px 14px 14px 4px;padding:11px 14px;color:var(--label);
  }
  .msg.user{
    background:var(--accent);color:#fff;border-radius:14px 14px 4px 14px;padding:11px 14px;margin-left:auto;
  }
  #chat-opts{padding:0 16px 16px;display:flex;flex-wrap:wrap;gap:8px;}
  #chat-opts button{
    font-size:13px;background:none;border:1px solid var(--separator);color:var(--label);
    border-radius:980px;padding:8px 14px;cursor:pointer;transition:all .15s ease;
  }
  #chat-opts button:hover{background:var(--fill);border-color:var(--label);}
  #chat-opts button.buy{background:var(--accent);color:#fff;border-color:var(--accent);}
</style>
</head>
<body>

{!PUBLICADO && (
  <div class="rascunho-bar">Rascunho, visivel so por link. Cole o link do checkout Hotmart para publicar.</div>
)}

<header class="hero">
  <div class="wrap">
    <span class="eyebrow">Ebook · Mente do Mercado</span>
    <h1>Marketing com Estratégia <em>não é discurso</em></h1>
    <p class="lede">Um método direto para transformar estratégia de palavra bonita em critério de decisão na sua rotina de marketing.</p>
    <div class="cta-block">
      <a href="#" class="btn js-checkout">Quero o ebook por R$ 67</a>
      <p class="micro">Acesso digital imediato pela Hotmart. Garantia de 7 dias.</p>
    </div>
  </div>
</header>

<section>
  <div class="wrap">
    <span class="eyebrow">O problema</span>
    <h2>A palavra que todo mundo usa e quase ninguém pratica</h2>
    <p>Estratégia aparece em toda reunião, em toda proposta e em todo perfil de LinkedIn. Mas na segunda-feira de manhã a rotina é outra: pedidos chegando de todo lado, urgência atropelando prioridade e o marketing tratado como central de produção de peças.</p>
    <p>O problema não é falta de conhecimento. É falta de critério aplicado. Saber o conceito de posicionamento não resolve quando o diretor pede um post para amanhã e você não tem argumento para dizer o que entra na frente do quê.</p>
    <p>Este ebook trata exatamente dessa distância: a que separa o discurso de estratégia da prática de decidir com critério.</p>
  </div>
</section>

<section class="tint">
  <div class="wrap">
    <span class="eyebrow">Público</span>
    <h2>Para quem é. E para quem não é.</h2>
    <div class="cols">
      <div class="col-card">
        <h3>É para você se</h3>
        <ul class="plain">
          <li>Trabalha com marketing em empresa real, de analista a coordenador ou gerente</li>
          <li>Está cansado de ser tratado como quem só faz post e campanha</li>
          <li>Quer sustentar decisões com argumento, não com opinião</li>
          <li>Prefere método aplicável a inspiração de palco</li>
        </ul>
      </div>
      <div class="col-card nao">
        <h3>Não é para você se</h3>
        <ul class="plain">
          <li>Busca fórmula rápida de dinheiro ou promessa de resultado garantido</li>
          <li>Nunca trabalhou em uma operação de marketing de verdade</li>
          <li>Quer template pronto para copiar sem pensar</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <span class="eyebrow">Conteúdo</span>
    <h2>O que você leva</h2>
    <ul class="plain">
      <li>Critério para priorizar demandas quando tudo parece urgente</li>
      <li>Como transformar estratégia de slide em decisão de rotina</li>
      <li>Argumentos para sustentar suas escolhas diante de chefe e diretoria</li>
      <li>O caminho para sair do modo central de pedidos sem criar guerra interna</li>
      <li>Método usado em operação de marketing real, não teoria de palco</li>
    </ul>
  </div>
</section>

<section class="tint">
  <div class="wrap">
    <span class="eyebrow">Quem escreve</span>
    <h2>Bruno Massa</h2>
    <p>Executivo de marketing com carreira construída dentro de operação real, não de palco. Criador do Mente do Mercado, canal sobre marketing, negócios, marcas e comportamento do consumidor.</p>
    <p>O que está no ebook vem do bastidor corporativo: decisões defendidas em diretoria, orçamento disputado, prioridade negociada. É esse repertório, organizado em método, que você recebe.</p>
  </div>
</section>

<section>
  <div class="wrap">
    <span class="eyebrow">Investimento</span>
    <h2>Preço honesto, sem teatro</h2>
    <p>R$ 67 é o preço cheio. Sem desconto fictício, sem contador regressivo, sem "últimas unidades" de um produto digital que não tem estoque. Você decide com calma.</p>
    <div class="price-box">
      <span class="eyebrow">Ebook completo</span>
      <div class="valor"><small>R$</small> 67</div>
      <p class="micro">Pagamento único. Acesso imediato pela Hotmart.</p>
      <div class="cta-block">
        <a href="#" class="btn js-checkout">Comprar o ebook</a>
        <p class="micro">Se não for para você, reembolso integral em até 7 dias, direto pela Hotmart.</p>
      </div>
    </div>
  </div>
</section>

<section class="tint">
  <div class="wrap">
    <span class="eyebrow">Dúvidas</span>
    <h2>Perguntas frequentes</h2>
    <details>
      <summary>Como recebo o ebook depois da compra?</summary>
      <p>A compra é processada pela Hotmart. Assim que o pagamento é aprovado, você recebe por e-mail o acesso à área de membros para baixar o material. No cartão a aprovação costuma ser imediata.</p>
    </details>
    <details>
      <summary>E se eu comprar e não gostar?</summary>
      <p>Você tem 7 dias de garantia, como manda o Código de Defesa do Consumidor. O pedido de reembolso é feito direto na Hotmart, sem precisar justificar e sem burocracia.</p>
    </details>
    <details>
      <summary>Já consumo muito conteúdo grátis sobre marketing. Por que pagar?</summary>
      <p>Conteúdo grátis, inclusive o do canal Mente do Mercado, ensina em pedaços. O ebook organiza o método em sequência aplicável, do diagnóstico ao argumento. É a diferença entre assistir aulas soltas e ter o mapa inteiro.</p>
    </details>
    <details>
      <summary>Sou iniciante. Vale para mim?</summary>
      <p>Se você ainda não trabalha em uma operação de marketing, provavelmente não é o momento. O material assume que você vive a rotina de demandas de uma empresa real. Prefiro que você não compre agora a comprar e não aproveitar.</p>
    </details>
    <details>
      <summary>Isso promete que vou ser promovido ou ganhar mais?</summary>
      <p>Não. Promoção e salário dependem de fatores que nenhum ebook controla. O que o material entrega é método: critério para decidir e argumento para sustentar decisões. O resto é trabalho seu.</p>
    </details>
  </div>
</section>

<footer>
  <div class="wrap">
    <p>Mente do Mercado · Bruno Massa</p>
    <p>Compra processada com segurança pela Hotmart.</p>
  </div>
</footer>

<!-- ===== Assistente de duvidas ===== -->
<button id="chat-toggle">Dúvidas sobre o ebook?</button>
<div id="chat-panel" role="dialog" aria-label="Assistente de duvidas">
  <div id="chat-head">
    <span>Assistente do ebook</span>
    <button id="chat-close" aria-label="Fechar">×</button>
  </div>
  <div id="chat-log"></div>
  <div id="chat-opts"></div>
</div>

<script is:inline set:html={`var CHECKOUT_URL = ${JSON.stringify(CHECKOUT_URL)};`}></script>
<script is:inline>
(function(){
  var configurado = typeof CHECKOUT_URL === 'string' && CHECKOUT_URL.length > 0;

  document.querySelectorAll('.js-checkout').forEach(function(a){
    if(configurado){
      a.setAttribute('href', CHECKOUT_URL);
      a.classList.add('hotmart-fb','hotmart__button-checkout');
    } else {
      a.setAttribute('href', '#');
      a.setAttribute('aria-disabled', 'true');
      a.addEventListener('click', function(e){ e.preventDefault(); });
    }
  });

  var FLOWS = {
    start: {
      text: "Olá. Posso te ajudar a decidir se este ebook faz sentido para você. Sobre o que quer saber?",
      opts: [["oque","O que é o ebook"],["pra_mim","É para mim?"],["preco","Preço e garantia"],["entrega","Como recebo o acesso"],["comprar","Quero comprar"]]
    },
    oque: {
      text: "Marketing com Estratégia não é discurso é um ebook de Bruno Massa, criador do canal Mente do Mercado. Ele organiza em método o caminho para sair do modo central de pedidos: critério para priorizar, argumento para sustentar decisões e prática de rotina, não teoria de palco.",
      opts: [["pra_mim","É para mim?"],["preco","Preço e garantia"],["comprar","Quero comprar"],["start","Voltar"]]
    },
    pra_mim: {
      text: "É para quem trabalha com marketing em empresa real, de analista a coordenador ou gerente, e quer ser tratado como gente de negócio. Não é para quem busca fórmula rápida de dinheiro nem para quem nunca viveu uma operação de marketing. Se esse for o seu caso, sinceramente, não compre agora.",
      opts: [["oque","O que é o ebook"],["preco","Preço e garantia"],["comprar","Sou o perfil, quero comprar"],["start","Voltar"]]
    },
    preco: {
      text: "R$ 67, pagamento único, preço cheio e sem desconto de mentira. Você tem 7 dias de garantia pelo Código de Defesa do Consumidor: se não gostar, pede reembolso integral direto na Hotmart, sem justificar.",
      opts: [["entrega","Como recebo o acesso"],["comprar","Quero comprar"],["start","Voltar"]]
    },
    entrega: {
      text: "A compra é processada pela Hotmart. Aprovado o pagamento, você recebe por e-mail o acesso para baixar o ebook. No cartão a aprovação costuma ser imediata.",
      opts: [["preco","Preço e garantia"],["comprar","Quero comprar"],["start","Voltar"]]
    },
    comprar: {
      text: "Ótimo. O botão abaixo abre o checkout seguro da Hotmart. Qualquer dúvida depois da compra, o suporte da Hotmart e o e-mail do produtor resolvem.",
      opts: [["__checkout","Abrir o checkout"],["start","Voltar"]]
    }
  };

  var panel=document.getElementById('chat-panel'),
      log=document.getElementById('chat-log'),
      opts=document.getElementById('chat-opts'),
      toggle=document.getElementById('chat-toggle');

  function addMsg(text,who){
    var d=document.createElement('div');
    d.className='msg '+who;
    d.textContent=text;
    log.appendChild(d);
    log.scrollTop=log.scrollHeight;
  }

  function show(key){
    var f=FLOWS[key];
    addMsg(f.text,'bot');
    opts.innerHTML='';
    f.opts.forEach(function(o){
      var b=document.createElement('button');
      b.textContent=o[1];
      if(o[0]==='__checkout'){
        b.className='buy';
        b.onclick=function(){ if(configurado){ window.open(CHECKOUT_URL,'_blank'); } };
      } else {
        b.onclick=function(){ addMsg(o[1],'user'); show(o[0]); };
      }
      opts.appendChild(b);
    });
  }

  var started=false;
  toggle.onclick=function(){
    panel.classList.toggle('open');
    if(panel.classList.contains('open') && !started){ started=true; show('start'); }
  };
  document.getElementById('chat-close').onclick=function(){ panel.classList.remove('open'); };
})();
</script>
</body>
</html>
