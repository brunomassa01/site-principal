---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.rascunho))
  .sort((a, b) => b.data.data.valueOf() - a.data.data.valueOf());
---
<BaseLayout title="Conteúdo autoral">
  <Header />
  <main>
    <h1>Conteúdo autoral</h1>
    {posts.length === 0 ? (
      <p>Em breve.</p>
    ) : (
      <ul>
        {posts.map((p) => (
          <li>
            <h2><a href={`/posts/${p.slug}`}>{p.data.titulo}</a></h2>
            <p><time>{p.data.data.toLocaleDateString('pt-BR')}</time></p>
            <p>{p.data.resumo}</p>
            {p.data.fonte_externa_url && (
              <p><small>Originalmente publicado em {p.data.fonte_externa_nome ?? 'fonte externa'}.</small></p>
            )}
          </li>
        ))}
      </ul>
    )}
  </main>
  <Footer />
</BaseLayout>
