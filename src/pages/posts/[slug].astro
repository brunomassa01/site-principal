---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getPostBySlug, incrementViews } from '../../lib/content/posts';
import { renderBody } from '../../lib/content/render';
import Reactions from '../../components/Reactions.tsx';

export const prerender = false;

const { slug } = Astro.params;
const post = slug ? await getPostBySlug(slug) : null;
if (!post) return Astro.redirect('/posts');
await incrementViews(slug!);

const fmtData = (d: Date) => d.toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric' });

const postUrl = new URL(Astro.url.pathname, 'https://www.brunomassa.online').href;
const linkedinShare = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(postUrl)}`;
---
<BaseLayout title={post.data.titulo} descricao={post.data.resumo} imagem={post.data.capa_url ?? undefined} tipo="article">
  <Header />
  <main>
    <!-- Post header -->
    <section class="bg-white py-16 md:py-20">
      <div class="max-w-3xl mx-auto px-6">
        <a href="/posts" class="inline-flex items-center gap-1.5 text-[13px] text-apple-secondary hover:text-apple-label transition-colors mb-8">
          ← Conteúdo
        </a>

        <div class="flex flex-wrap items-center gap-2 mb-4">
          <time class="text-[12px] font-semibold uppercase tracking-wider text-apple-tertiary">
            {fmtData(post.data.data)}
          </time>
          {post.data.idioma === 'en' && (
            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-apple-fill text-apple-secondary border border-apple-separator-light">
              English
            </span>
          )}
        </div>

        <h1 class="text-4xl md:text-5xl font-bold text-apple-label tracking-tight leading-tight mb-4 text-balance">
          {post.data.titulo}
        </h1>

        <p class="text-[20px] text-apple-secondary font-normal leading-relaxed mb-4 text-balance">
          {post.data.resumo}
        </p>

        {post.data.fonte_externa_url && (
          <div class="mt-4 pt-4 border-t border-apple-separator-light">
            <p class="text-[13px] text-apple-tertiary">
              Originalmente publicado em{' '}
              <a href={post.data.fonte_externa_url} target="_blank" rel="noopener" class="text-apple-accent hover:underline">
                {post.data.fonte_externa_nome ?? 'fonte externa'} ↗
              </a>
            </p>
          </div>
        )}

        {post.data.tags && post.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-6">
            {post.data.tags.map((tag) => (
              <span class="px-3 py-1 rounded-full text-[12px] font-medium bg-apple-fill text-apple-secondary border border-apple-separator-light">
                {tag}
              </span>
            ))}
          </div>
        )}
      </div>
    </section>

    {post.data.capa_url && (
      <section class="pt-2">
        <div class="max-w-3xl mx-auto px-6">
          <img src={post.data.capa_url} alt={post.data.titulo} class="w-full rounded-2xl shadow-card" />
        </div>
      </section>
    )}

    <!-- Post body -->
    <section class="py-12">
      <div class="max-w-3xl mx-auto px-6">
        <article class="bg-apple-surface rounded-2xl shadow-card p-8 md:p-10">
          <div class="prose-content" set:html={renderBody(post.bodyHtml)} />
        </article>

        <Reactions client:visible slug={slug!} />

        <div class="mt-8 pt-8 border-t border-apple-separator-light flex flex-wrap items-center justify-between gap-4">
          <a href="/posts" class="text-[15px] text-apple-accent hover:underline">← Voltar para conteúdo</a>
          <a
            href={linkedinShare}
            target="_blank"
            rel="noopener"
            aria-label="Compartilhar no LinkedIn"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#0A66C2] text-white text-[14px] font-medium hover:bg-[#004182] transition-colors"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zm1.78 13.02H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/>
            </svg>
            Compartilhar no LinkedIn
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
