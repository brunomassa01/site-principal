---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const timeline = (await getCollection('timeline'))
  .sort((a, b) => b.data.inicio.valueOf() - a.data.inicio.valueOf());

const projetos = (await getCollection('projetos'))
  .sort((a, b) => b.data.inicio.valueOf() - a.data.inicio.valueOf());

const cargoAtual = timeline.find((t) => !t.data.fim);
const carreiraDestaque = timeline.filter((t) => t.data.destaque || !t.data.fim).slice(0, 3);
const projetosDestaque = projetos.filter((p) => p.data.destaque).length > 0
  ? projetos.filter((p) => p.data.destaque).slice(0, 4)
  : projetos.slice(0, 4);

const statusLabel: Record<string, string> = {
  'em-andamento': 'Em andamento',
  'concluido': 'Concluído',
  'em-pausa': 'Em pausa',
  'arquivado': 'Arquivado',
};

const fmtMesAno = (d: Date) => d.toLocaleDateString('pt-BR', { month: 'short', year: 'numeric' });
---
<BaseLayout title="Bruno Massa" descricao="Bruno Massa — profissional de marketing, produto e negócios. Currículo vivo em movimento.">
  <Header />
  <main>
    <!-- Hero: scroll-driven video -->
    <div id="hero-wrapper" style="height:400vh;position:relative;">
      <section id="hero-sticky" class="sticky top-0 h-screen overflow-hidden bg-black">

        <!-- Vídeo de fundo -->
        <video
          id="hero-video"
          class="absolute inset-0 w-full h-full object-cover object-center"
          preload="auto"
          muted
          playsinline
          disablepictureinpicture
          aria-hidden="true"
        >
          <source src="/videos/hero.mp4" type="video/mp4" />
        </video>

        <!-- Gradiente de legibilidade: escuro à esquerda -->
        <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/50 to-black/10 pointer-events-none"></div>
        <!-- Gradiente de rodapé -->
        <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent pointer-events-none"></div>

        <!-- Conteúdo -->
        <div class="relative z-10 h-full flex items-center">
          <div class="max-w-5xl mx-auto px-6 w-full">
            <div class="max-w-lg">
              {cargoAtual && (
                <p class="text-[12px] font-semibold uppercase tracking-[0.08em] text-blue-300 mb-5">
                  {cargoAtual.data.cargo} · {cargoAtual.data.empresa}
                </p>
              )}
              <h1 class="text-5xl md:text-6xl font-bold text-white tracking-tight leading-none mb-5">
                Bruno Massa
              </h1>
              <p class="text-xl md:text-2xl font-normal text-white/80 tracking-tight leading-snug mb-5">
                Marketing · Produto · Negócios
              </p>
              <p class="text-[17px] text-white/70 leading-relaxed max-w-md mb-8">
                Construindo marcas, times e resultados com estratégia, dados e visão de produto.
                Currículo vivo — em movimento, não em PDF.
              </p>
              <div class="flex flex-wrap gap-3">
                <a
                  href="/timeline"
                  class="inline-flex items-center gap-2 px-6 py-3 bg-white text-gray-900 rounded-full text-[15px] font-medium transition-colors duration-200 hover:bg-white/90"
                >
                  Ver trajetória
                </a>
                <a
                  href="/projetos"
                  class="inline-flex items-center gap-2 px-6 py-3 bg-white/15 text-white rounded-full text-[15px] font-medium border border-white/30 transition-colors duration-200 hover:bg-white/25"
                >
                  Ver projetos
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Barra de progresso do vídeo -->
        <div class="absolute bottom-0 left-0 right-0 h-0.5 bg-white/10">
          <div id="hero-progress" class="h-full bg-white/50" style="width:0%;transition:none;"></div>
        </div>

        <!-- Indicador de scroll -->
        <div id="scroll-cue" class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 transition-opacity duration-500 pointer-events-none">
          <span class="text-white/40 text-[11px] uppercase tracking-widest">Scroll</span>
          <svg class="w-4 h-4 text-white/40 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7"/>
          </svg>
        </div>

      </section>
    </div>

    <script>
      (function () {
        var wrapper = document.getElementById('hero-wrapper');
        var video = document.getElementById('hero-video');
        var bar = document.getElementById('hero-progress');
        var cue = document.getElementById('scroll-cue');
        if (!wrapper || !video) return;

        // Garante vídeo parado — scroll controla currentTime
        video.pause();

        function seek(pct) {
          var dur = video.duration;
          if (!isFinite(dur) || dur <= 0) return;
          var t = pct * dur;
          if (Math.abs(video.currentTime - t) > 0.016) video.currentTime = t;
          if (bar) bar.style.width = (pct * 100).toFixed(1) + '%';
          if (cue) cue.style.opacity = pct < 0.03 ? '1' : '0';
        }

        function onScroll() {
          var rect = wrapper.getBoundingClientRect();
          var scrollable = wrapper.offsetHeight - window.innerHeight;
          if (scrollable <= 0) return;
          var pct = Math.min(1, Math.max(0, -rect.top / scrollable));
          seek(pct);
        }

        video.addEventListener('loadedmetadata', function () {
          video.pause();
          video.currentTime = 0;
        });

        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      })();
    </script>

    <!-- Trajetória em destaque -->
    {carreiraDestaque.length > 0 && (
      <section class="py-20">
        <div class="max-w-5xl mx-auto px-6">
          <div class="flex items-end justify-between mb-10">
            <div>
              <p class="text-[12px] font-semibold uppercase tracking-[0.08em] text-apple-accent mb-2">Trajetória</p>
              <h2 class="text-3xl md:text-4xl font-bold text-apple-label tracking-tight">Passagens em destaque</h2>
            </div>
            <a href="/timeline" class="text-[15px] text-apple-accent hover:underline hidden sm:block">
              Ver completa →
            </a>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {carreiraDestaque.map((item) => (
              <div class="bg-apple-surface rounded-2xl shadow-card p-6 transition-all duration-300 hover:shadow-card-hover hover:-translate-y-0.5">
                <div class="mb-4">
                  {!item.data.fim && (
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-green-50 text-green-700 border border-green-200 mb-3">
                      Atual
                    </span>
                  )}
                  <h3 class="text-[17px] font-semibold text-apple-label tracking-tight leading-snug">{item.data.cargo}</h3>
                  <p class="text-[14px] text-apple-accent font-medium mt-1">{item.data.empresa}</p>
                </div>
                <p class="text-[13px] text-apple-tertiary mb-3">
                  {fmtMesAno(item.data.inicio)} – {item.data.fim ? fmtMesAno(item.data.fim) : 'Atual'}
                  {item.data.local && <span class="ml-2">· {item.data.local}</span>}
                </p>
                {item.data.resumo && (
                  <p class="text-[14px] text-apple-secondary leading-relaxed line-clamp-3">{item.data.resumo}</p>
                )}
              </div>
            ))}
          </div>
          <div class="mt-6 sm:hidden">
            <a href="/timeline" class="text-[15px] text-apple-accent hover:underline">Ver trajetória completa →</a>
          </div>
        </div>
      </section>
    )}

    <!-- Projetos selecionados -->
    {projetosDestaque.length > 0 && (
      <section class="bg-white py-20">
        <div class="max-w-5xl mx-auto px-6">
          <div class="flex items-end justify-between mb-10">
            <div>
              <p class="text-[12px] font-semibold uppercase tracking-[0.08em] text-apple-accent mb-2">Projetos</p>
              <h2 class="text-3xl md:text-4xl font-bold text-apple-label tracking-tight">Trabalhos selecionados</h2>
            </div>
            <a href="/projetos" class="text-[15px] text-apple-accent hover:underline hidden sm:block">
              Ver todos →
            </a>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {projetosDestaque.map((p) => (
              <a
                href={`/projetos/${p.slug}`}
                class="group bg-apple-fill rounded-2xl p-6 transition-all duration-300 hover:bg-apple-surface hover:shadow-card-hover hover:-translate-y-0.5"
              >
                <div class="flex items-start justify-between gap-4 mb-3">
                  <h3 class="text-[17px] font-semibold text-apple-label tracking-tight leading-snug group-hover:text-apple-accent transition-colors">
                    {p.data.titulo}
                  </h3>
                  <span class={`flex-none inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold border ${
                    p.data.status === 'em-andamento'
                      ? 'bg-green-50 text-green-700 border-green-200'
                      : p.data.status === 'concluido'
                      ? 'bg-blue-50 text-blue-600 border-blue-200'
                      : 'bg-gray-50 text-gray-500 border-gray-200'
                  }`}>
                    {statusLabel[p.data.status]}
                  </span>
                </div>
                {p.data.subtitulo && (
                  <p class="text-[13px] text-apple-accent font-medium mb-2">{p.data.subtitulo}</p>
                )}
                <p class="text-[14px] text-apple-secondary leading-relaxed line-clamp-2 mb-4">{p.data.resumo}</p>
                {p.data.tags && p.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-1.5">
                    {p.data.tags.slice(0, 4).map((tag) => (
                      <span class="px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-apple-separator-light text-apple-tertiary">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </a>
            ))}
          </div>
          <div class="mt-6 sm:hidden">
            <a href="/projetos" class="text-[15px] text-apple-accent hover:underline">Ver todos os projetos →</a>
          </div>
        </div>
      </section>
    )}

    <!-- Links rápidos -->
    <section class="py-20">
      <div class="max-w-5xl mx-auto px-6">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <a
            href="/skills"
            class="group bg-apple-surface rounded-2xl shadow-card p-6 transition-all duration-300 hover:shadow-card-hover hover:-translate-y-0.5"
          >
            <p class="text-[12px] font-semibold uppercase tracking-[0.08em] text-apple-accent mb-2">Competências</p>
            <h3 class="text-[20px] font-bold text-apple-label tracking-tight mb-2">Skills &amp; Formação</h3>
            <p class="text-[14px] text-apple-secondary leading-relaxed">Habilidades, certificações, idiomas e formação acadêmica.</p>
            <p class="mt-4 text-[13px] text-apple-accent group-hover:underline">Ver skills →</p>
          </a>
          <a
            href="/agora"
            class="group bg-apple-surface rounded-2xl shadow-card p-6 transition-all duration-300 hover:shadow-card-hover hover:-translate-y-0.5"
          >
            <p class="text-[12px] font-semibold uppercase tracking-[0.08em] text-apple-accent mb-2">Agora</p>
            <h3 class="text-[20px] font-bold text-apple-label tracking-tight mb-2">O que estou fazendo</h3>
            <p class="text-[14px] text-apple-secondary leading-relaxed">Foco atual, projetos em curso e o que estou aprendendo.</p>
            <p class="mt-4 text-[13px] text-apple-accent group-hover:underline">Ver agora →</p>
          </a>
          <a
            href="/contato"
            class="group bg-apple-surface rounded-2xl shadow-card p-6 transition-all duration-300 hover:shadow-card-hover hover:-translate-y-0.5"
          >
            <p class="text-[12px] font-semibold uppercase tracking-[0.08em] text-apple-accent mb-2">Contato</p>
            <h3 class="text-[20px] font-bold text-apple-label tracking-tight mb-2">Vamos conversar</h3>
            <p class="text-[14px] text-apple-secondary leading-relaxed">E-mail, LinkedIn ou uma conversa sobre projetos e oportunidades.</p>
            <p class="mt-4 text-[13px] text-apple-accent group-hover:underline">Entrar em contato →</p>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
