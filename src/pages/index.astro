---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getIdentidade, getTimeline, getProjetos } from '../lib/content/collections';
import { getPostsPublicados } from '../lib/content/posts';

export const prerender = false;

const id = (await getIdentidade()).data;

const timeline = (await getTimeline())
  .sort((a, b) => b.data.inicio.valueOf() - a.data.inicio.valueOf());

const projetos = (await getProjetos())
  .sort((a, b) => b.data.inicio.valueOf() - a.data.inicio.valueOf());

const cargoAtual = timeline.find((t) => !t.data.fim);
const carreiraDestaque = timeline.filter((t) => t.data.destaque || !t.data.fim).slice(0, 3);
const projetosDestaque = projetos.filter((p) => p.data.destaque).length > 0
  ? projetos.filter((p) => p.data.destaque).slice(0, 4)
  : projetos.slice(0, 4);

const statusLabel: Record<string, string> = {
  'em-andamento': 'Em andamento',
  'concluido': 'Concluído',
  'em-pausa': 'Em pausa',
  'arquivado': 'Arquivado',
};

const fmtMesAno = (d: Date) => d.toLocaleDateString('pt-BR', { month: 'short', year: 'numeric' });

const postsPublicados = await getPostsPublicados();
const postDestaque = postsPublicados[0];
const postsSecundarios = postsPublicados.slice(1, 4);
const fmtPostData = (d: Date) => d.toLocaleDateString('pt-BR', { day: 'numeric', month: 'short', year: 'numeric' });
---
<BaseLayout title={id.nome} descricao={id.descricao_meta}>
  <Header />
  <main>
    <!-- Hero: scroll-driven video -->
    <div id="hero-wrapper" style="height:400vh;position:relative;">
      <section id="hero-sticky" class="sticky top-0 h-screen overflow-hidden" style="background:#141414;">

        <!--
          Vídeo retrato (720×1280) em tela paisagem:
          Desktop → container 50% da largura do viewport (mín 56.25vh = 100vh×720/1280)
                     → object-contain mostra personagem completo; bg #141414 preenche as bordas
          Mobile  → full-width
        -->
        <div id="hero-video-wrap" class="absolute inset-y-0 right-0" style="width:clamp(56.25vh,50%,100%);">
          <video
            id="hero-video"
            class="w-full h-full"
            style="object-fit:contain;object-position:center;"
            preload="auto"
            muted
            playsinline
            disablepictureinpicture
            aria-hidden="true"
          >
            <source src="/videos/hero.mp4" type="video/mp4" />
          </video>
        </div>

        <!-- Gradiente: fundo #141414 sólido à esquerda (texto), esmaece até o vídeo -->
        <div class="absolute inset-0 pointer-events-none" style="background:linear-gradient(to right, #141414 30%, rgba(20,20,20,0.85) 48%, rgba(20,20,20,0.2) 66%, transparent 80%);"></div>
        <!-- Gradiente de rodapé -->
        <div class="absolute inset-0 pointer-events-none" style="background:linear-gradient(to top, rgba(20,20,20,0.5) 0%, transparent 30%);"></div>

        <!-- Conteúdo -->
        <div class="relative z-10 h-full flex items-center">
          <div class="max-w-5xl mx-auto px-6 w-full">
            <div class="max-w-lg">
              {cargoAtual && (
                <p class="text-[12px] font-semibold uppercase tracking-[0.08em] text-blue-300 mb-5">
                  {cargoAtual.data.cargo} · {cargoAtual.data.empresa}
                </p>
              )}
              <h1 class="text-5xl md:text-6xl font-semibold text-white tracking-tight leading-none mb-5">
                {id.nome}
              </h1>
              <p class="text-xl md:text-2xl font-normal text-white/80 tracking-tight leading-snug mb-4">
                {id.tagline}
              </p>
              {id.slogan && (
                <p class="text-[19px] md:text-[21px] font-medium text-white leading-snug max-w-md mb-3">
                  "{id.slogan}"
                </p>
              )}
              {id.bio_curta && (
                <p class="text-[14px] text-white/45 leading-relaxed max-w-md mb-8">
                  {id.bio_curta}
                </p>
              )}
              <div class="flex flex-wrap gap-3">
                <a
                  href="/timeline"
                  class="inline-flex items-center gap-2 px-6 py-3 bg-white text-gray-900 rounded-full text-[15px] font-medium transition-colors duration-200 hover:bg-white/90"
                >
                  Ver trajetória
                </a>
                <a
                  href="/projetos"
                  class="inline-flex items-center gap-2 px-6 py-3 bg-white/15 text-white rounded-full text-[15px] font-medium border border-white/30 transition-colors duration-200 hover:bg-white/25"
                >
                  Ver projetos
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Barra de progresso do vídeo -->
        <div class="absolute bottom-0 left-0 right-0 h-0.5 bg-white/10">
          <div id="hero-progress" class="h-full bg-white/50" style="width:0%;transition:none;"></div>
        </div>

        <!-- Indicador de scroll -->
        <div id="scroll-cue" class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 transition-opacity duration-500 pointer-events-none">
          <span class="text-white/40 text-[11px] uppercase tracking-widest">Scroll</span>
          <svg class="w-4 h-4 text-white/40 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7"/>
          </svg>
        </div>

      </section>
    </div>

    <script>
      (function () {
        var wrapper = document.getElementById('hero-wrapper');
        var video = document.getElementById('hero-video');
        var bar = document.getElementById('hero-progress');
        var cue = document.getElementById('scroll-cue');
        if (!wrapper || !video) return;

        // Garante vídeo parado — scroll controla currentTime
        video.pause();

        function seek(pct) {
          var dur = video.duration;
          if (!isFinite(dur) || dur <= 0) return;
          var t = pct * dur;
          if (Math.abs(video.currentTime - t) > 0.016) video.currentTime = t;
          if (bar) bar.style.width = (pct * 100).toFixed(1) + '%';
          if (cue) cue.style.opacity = pct < 0.03 ? '1' : '0';
        }

        function onScroll() {
          var rect = wrapper.getBoundingClientRect();
          var scrollable = wrapper.offsetHeight - window.innerHeight;
          if (scrollable <= 0) return;
          var pct = Math.min(1, Math.max(0, -rect.top / scrollable));
          seek(pct);
        }

        video.addEventListener('loadedmetadata', function () {
          video.pause();
          video.currentTime = 0;
        });

        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      })();
    </script>

    <!-- Carrossel de empresas -->
    <div class="bg-white border-y border-apple-separator/30 py-10 overflow-hidden select-none" aria-hidden="true">
      <p class="text-center text-[11px] font-semibold uppercase tracking-[0.1em] text-apple-tertiary mb-7">Empresas onde trabalhei</p>
      <div class="relative">
        <!-- Fade esquerda -->
        <div class="absolute inset-y-0 left-0 w-24 z-10 pointer-events-none" style="background:linear-gradient(to right,#fff,transparent);"></div>
        <!-- Fade direita -->
        <div class="absolute inset-y-0 right-0 w-24 z-10 pointer-events-none" style="background:linear-gradient(to left,#fff,transparent);"></div>
        <div class="marquee-track flex gap-16 items-center w-max">
          {[
            'Office Paper','Sequencia 1','MCF Consultoria','Boucinhas & Campos','Tokka Simultânea',
            'Sab Group','SindusCon-SP','Selo7','Seconci-SP','Ultralinks','Grupo Quali',
            'Office Paper','Sequencia 1','MCF Consultoria','Boucinhas & Campos','Tokka Simultânea',
            'Sab Group','SindusCon-SP','Selo7','Seconci-SP','Ultralinks','Grupo Quali',
          ].map((nome) => (
            <span class="text-[15px] font-medium text-apple-tertiary whitespace-nowrap hover:text-apple-secondary transition-colors duration-200 cursor-default">
              {nome}
            </span>
          ))}
        </div>
      </div>
    </div>

    <style>
      .marquee-track {
        animation: marquee 30s linear infinite;
      }
      .marquee-track:hover {
        animation-play-state: paused;
      }
      @keyframes marquee {
        0%   { transform: translateX(0); }
        100% { transform: translateX(-50%); }
      }
    </style>

    <!-- Trajetória em destaque -->
    {carreiraDestaque.length > 0 && (
      <section class="py-20">
        <div class="max-w-5xl mx-auto px-6">
          <div class="flex items-end justify-between mb-10">
            <div>
              <p class="text-[12px] font-semibold uppercase tracking-[0.08em] text-apple-accent mb-2">Trajetória</p>
              <h2 class="text-3xl md:text-4xl font-bold text-apple-label tracking-tight">Passagens em destaque</h2>
            </div>
            <a href="/timeline" class="text-[15px] text-apple-accent hover:underline hidden sm:block">
              Ver completa →
            </a>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {carreiraDestaque.map((item) => (
              <div class="bg-apple-surface rounded-2xl shadow-card p-6 transition-all duration-300 hover:shadow-card-hover hover:-translate-y-0.5">
                <div class="mb-4">
                  {!item.data.fim && (
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-green-50 text-green-700 border border-green-200 mb-3">
                      Atual
                    </span>
                  )}
                  <h3 class="text-[17px] font-semibold text-apple-label tracking-tight leading-snug">{item.data.cargo}</h3>
                  <p class="text-[14px] text-apple-accent font-medium mt-1">{item.data.empresa}</p>
                </div>
                <p class="text-[13px] text-apple-tertiary mb-3">
                  {fmtMesAno(item.data.inicio)} – {item.data.fim ? fmtMesAno(item.data.fim) : 'Atual'}
                  {item.data.local && <span class="ml-2">· {item.data.local}</span>}
                </p>
                {item.data.resumo && (
                  <p class="text-[14px] text-apple-secondary leading-relaxed line-clamp-3">{item.data.resumo}</p>
                )}
              </div>
            ))}
          </div>
          <div class="mt-6 sm:hidden">
            <a href="/timeline" class="text-[15px] text-apple-accent hover:underline">Ver trajetória completa →</a>
          </div>
        </div>
      </section>
    )}

    <!-- Projetos selecionados -->
    {projetosDestaque.length > 0 && (
      <section class="bg-white py-20">
        <div class="max-w-5xl mx-auto px-6">
          <div class="flex items-end justify-between mb-10">
            <div>
              <p class="text-[12px] font-semibold uppercase tracking-[0.08em] text-apple-accent mb-2">Projetos</p>
              <h2 class="text-3xl md:text-4xl font-bold text-apple-label tracking-tight">Trabalhos selecionados</h2>
            </div>
            <a href="/projetos" class="text-[15px] text-apple-accent hover:underline hidden sm:block">
              Ver todos →
            </a>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {projetosDestaque.map((p) => (
              <a
                href={`/projetos/${p.slug}`}
                class="group bg-apple-fill rounded-2xl p-6 transition-all duration-300 hover:bg-apple-surface hover:shadow-card-hover hover:-translate-y-0.5"
              >
                <div class="flex items-start justify-between gap-4 mb-3">
                  <h3 class="text-[17px] font-semibold text-apple-label tracking-tight leading-snug group-hover:text-apple-accent transition-colors">
                    {p.data.titulo}
                  </h3>
                  <span class={`flex-none inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold border ${
                    p.data.status === 'em-andamento'
                      ? 'bg-green-50 text-green-700 border-green-200'
                      : p.data.status === 'concluido'
                      ? 'bg-blue-50 text-blue-600 border-blue-200'
                      : 'bg-gray-50 text-gray-500 border-gray-200'
                  }`}>
                    {statusLabel[p.data.status]}
                  </span>
                </div>
                {p.data.subtitulo && (
                  <p class="text-[13px] text-apple-accent font-medium mb-2">{p.data.subtitulo}</p>
                )}
                <p class="text-[14px] text-apple-secondary leading-relaxed line-clamp-2 mb-4">{p.data.resumo}</p>
                {p.data.tags && p.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-1.5">
                    {p.data.tags.slice(0, 4).map((tag) => (
                      <span class="px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-apple-separator-light text-apple-tertiary">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </a>
            ))}
          </div>
          <div class="mt-6 sm:hidden">
            <a href="/projetos" class="text-[15px] text-apple-accent hover:underline">Ver todos os projetos →</a>
          </div>
        </div>
      </section>
    )}

    <!-- Blog em destaque -->
    {postDestaque && (
      <section class="py-20">
        <div class="max-w-5xl mx-auto px-6">
          <div class="flex items-end justify-between mb-10">
            <div>
              <p class="text-[12px] font-semibold uppercase tracking-[0.08em] text-apple-accent mb-2">Conteúdo</p>
              <h2 class="text-3xl md:text-4xl font-bold text-apple-label tracking-tight">Escrevo por aqui</h2>
            </div>
            <a href="/posts" class="text-[15px] text-apple-accent hover:underline hidden sm:block">
              Ver tudo →
            </a>
          </div>

          <!-- Post em destaque -->
          <a
            href={`/posts/${postDestaque.slug}`}
            class="group block rounded-2xl overflow-hidden bg-apple-surface shadow-card transition-all duration-300 hover:shadow-card-hover mb-4"
          >
            <div class="grid md:grid-cols-2">
              <div class="relative aspect-[16/10] md:aspect-auto md:min-h-[280px] overflow-hidden bg-gradient-to-br from-apple-label to-[#2d2d2f]">
                {postDestaque.data.capa_url ? (
                  <img
                    src={postDestaque.data.capa_url}
                    alt=""
                    class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
                  />
                ) : (
                  <span class="absolute inset-0 flex items-center justify-center text-white/15 text-[110px] font-serif leading-none select-none">“</span>
                )}
              </div>
              <div class="p-8 md:p-10 flex flex-col justify-center">
                <div class="flex items-center gap-2 mb-3">
                  <span class="text-[11px] font-semibold uppercase tracking-[0.08em] text-apple-accent">Mais recente</span>
                  <span class="text-apple-separator">·</span>
                  <time class="text-[12px] text-apple-tertiary">{fmtPostData(postDestaque.data.data)}</time>
                </div>
                <h3 class="text-[24px] md:text-[28px] font-bold text-apple-label tracking-tight leading-snug mb-3 text-balance group-hover:text-apple-accent transition-colors">
                  {postDestaque.data.titulo}
                </h3>
                <p class="text-[15px] text-apple-secondary leading-relaxed line-clamp-3 mb-5">
                  {postDestaque.data.resumo}
                </p>
                <span class="text-[15px] font-medium text-apple-accent">Ler artigo →</span>
              </div>
            </div>
          </a>

          <!-- Próximos posts -->
          {postsSecundarios.length > 0 && (
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              {postsSecundarios.map((p) => (
                <a
                  href={`/posts/${p.slug}`}
                  class="group block bg-apple-surface rounded-2xl overflow-hidden shadow-card transition-all duration-300 hover:shadow-card-hover hover:-translate-y-0.5"
                >
                  <div class="relative aspect-[16/9] overflow-hidden bg-gradient-to-br from-apple-label to-[#2d2d2f]">
                    {p.data.capa_url ? (
                      <img
                        src={p.data.capa_url}
                        alt=""
                        class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
                      />
                    ) : (
                      <span class="absolute inset-0 flex items-center justify-center text-white/15 text-[64px] font-serif leading-none select-none">“</span>
                    )}
                  </div>
                  <div class="p-5">
                    <time class="text-[12px] text-apple-tertiary">{fmtPostData(p.data.data)}</time>
                    <h4 class="text-[15px] font-semibold text-apple-label tracking-tight leading-snug mt-1.5 line-clamp-2 group-hover:text-apple-accent transition-colors">
                      {p.data.titulo}
                    </h4>
                  </div>
                </a>
              ))}
            </div>
          )}

          <div class="mt-6 sm:hidden">
            <a href="/posts" class="text-[15px] text-apple-accent hover:underline">Ver todo o conteúdo →</a>
          </div>
        </div>
      </section>
    )}

    <!-- Calculadora INK -->
    <section class="py-20 bg-white border-y border-apple-separator/30">
      <div class="max-w-5xl mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
          <div>
            <p class="text-[12px] font-semibold uppercase tracking-[0.08em] text-apple-accent mb-2">Calculadora INK</p>
            <h2 class="text-3xl md:text-4xl font-bold text-apple-label tracking-tight mb-4 text-balance">Quanto vale a narrativa da sua marca?</h2>
            <p class="text-[16px] text-apple-secondary leading-relaxed mb-6 max-w-lg">
              No livro Narrativa em KPI eu criei um índice pra medir o que a marca constrói antes do clique. Três dimensões viram um número, e o número vira diagnóstico: do estágio da sua narrativa ao custo invisível da incoerência.
            </p>
            <div class="flex flex-wrap gap-3">
              <a href="https://selo7.com.br/calculadorakpi/" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-6 py-3 bg-apple-label text-white rounded-full text-[15px] font-medium transition-colors duration-200 hover:bg-black">
                Calcular o INK ↗
              </a>
              <a href="/palestras" class="inline-flex items-center gap-2 px-6 py-3 bg-apple-fill text-apple-label rounded-full text-[15px] font-medium border border-apple-separator transition-colors duration-200 hover:bg-apple-separator-light">
                Levar o método pro seu evento →
              </a>
            </div>
            <p class="text-[12px] text-apple-tertiary mt-4">Instrumento autoral, aberto e gratuito. Desenvolvido na <a href="https://selo7.com.br" target="_blank" rel="noopener" class="underline hover:text-apple-accent">Selo7</a>, minha agência.</p>
          </div>
          <div class="bg-apple-fill rounded-2xl p-8">
            <p class="text-center text-[26px] md:text-[32px] font-bold text-apple-label tracking-tight mb-6" aria-label="Fórmula do índice INK">
              INK = ( R + C + P ) ÷ 3
            </p>
            <div class="space-y-3">
              <div class="bg-white rounded-xl p-4 shadow-card">
                <p class="text-[14px] font-semibold text-apple-label"><span class="text-apple-accent font-bold mr-2">R</span>Reconhecimento prévio</p>
                <p class="text-[13px] text-apple-secondary mt-0.5">quantos chegam já sabendo quem você é</p>
              </div>
              <div class="bg-white rounded-xl p-4 shadow-card">
                <p class="text-[14px] font-semibold text-apple-label"><span class="text-apple-accent font-bold mr-2">C</span>Coerência percebida</p>
                <p class="text-[13px] text-apple-secondary mt-0.5">se a promessa e a entrega contam a mesma história</p>
              </div>
              <div class="bg-white rounded-xl p-4 shadow-card">
                <p class="text-[14px] font-semibold text-apple-label"><span class="text-apple-accent font-bold mr-2">P</span>Permanência espontânea</p>
                <p class="text-[13px] text-apple-secondary mt-0.5">o que fica na memória sem mídia empurrando</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Livro destaque -->
    <section class="py-16 bg-white">
      <div class="max-w-5xl mx-auto px-6">
        <div class="bg-gradient-to-r from-apple-label to-[#2d2d2f] rounded-2xl p-8 md:p-10 flex flex-col sm:flex-row sm:items-center gap-6">
          <div class="flex-1">
            <p class="text-[11px] font-semibold uppercase tracking-[0.1em] text-white/50 mb-3">Livro</p>
            <h2 class="text-[22px] md:text-[26px] font-bold text-white tracking-tight leading-snug mb-3">
              Marketing na Era da Inteligência Artificial
            </h2>
            <p class="text-[15px] text-white/70 leading-relaxed max-w-lg">
              Os movimentos práticos que estão redesenhando o marketing corporativo. Disponível na Amazon.
            </p>
          </div>
          <div class="flex-none">
            <a
              href="https://www.amazon.com.br/dp/B0DVZCQZP8?tag=lojadomassa-20"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 px-6 py-3.5 bg-[#FF9900] text-white rounded-full text-[15px] font-semibold transition-all duration-200 hover:bg-[#e68a00] hover:shadow-lg whitespace-nowrap"
            >
              Comprar na Amazon ↗
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Links rápidos -->
    <section class="py-20">
      <div class="max-w-5xl mx-auto px-6">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <a
            href="/skills"
            class="group bg-apple-surface rounded-2xl shadow-card p-6 transition-all duration-300 hover:shadow-card-hover hover:-translate-y-0.5"
          >
            <p class="text-[12px] font-semibold uppercase tracking-[0.08em] text-apple-accent mb-2">Competências</p>
            <h3 class="text-[20px] font-bold text-apple-label tracking-tight mb-2">Skills &amp; Formação</h3>
            <p class="text-[14px] text-apple-secondary leading-relaxed">Habilidades, certificações, idiomas e formação acadêmica.</p>
            <p class="mt-4 text-[13px] text-apple-accent group-hover:underline">Ver skills →</p>
          </a>
          <a
            href="/agora"
            class="group bg-apple-surface rounded-2xl shadow-card p-6 transition-all duration-300 hover:shadow-card-hover hover:-translate-y-0.5"
          >
            <p class="text-[12px] font-semibold uppercase tracking-[0.08em] text-apple-accent mb-2">Agora</p>
            <h3 class="text-[20px] font-bold text-apple-label tracking-tight mb-2">Agora &amp; Publicações</h3>
            <p class="text-[14px] text-apple-secondary leading-relaxed">Foco atual, publicações e anotações sobre marketing, narrativa e IA.</p>
            <p class="mt-4 text-[13px] text-apple-accent group-hover:underline">Ver agora →</p>
          </a>
          <a
            href="/contato"
            class="group bg-apple-surface rounded-2xl shadow-card p-6 transition-all duration-300 hover:shadow-card-hover hover:-translate-y-0.5"
          >
            <p class="text-[12px] font-semibold uppercase tracking-[0.08em] text-apple-accent mb-2">Contato</p>
            <h3 class="text-[20px] font-bold text-apple-label tracking-tight mb-2">Vamos conversar</h3>
            <p class="text-[14px] text-apple-secondary leading-relaxed">E-mail, LinkedIn ou uma conversa sobre projetos e oportunidades.</p>
            <p class="mt-4 text-[13px] text-apple-accent group-hover:underline">Entrar em contato →</p>
          </a>
