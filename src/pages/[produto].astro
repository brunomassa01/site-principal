---
import { getLandingPage } from '../lib/content/lp';
import Candidatura from '../components/lp/Candidatura.tsx';

export const prerender = false;

// Esta rota-coringa só serve landing pages, e só no subdomínio lp.
// No domínio principal (brunomassa.online) qualquer /algo aqui é 404 —
// a LP não faz parte do currículo.
const host = Astro.url.host;
const ehLp = host.startsWith('lp.') || Astro.url.searchParams.has('preview'); // ?preview=1 p/ testar no principal
if (!ehLp) return new Response('Not Found', { status: 404 });

const { produto } = Astro.params;
const lp = produto ? await getLandingPage(produto) : null;
if (!lp || !lp.dados) return new Response('Not Found', { status: 404 });

const d = lp.dados as any;
const rascunho = lp.status !== 'publicado';
const anoAtual = new Date().getFullYear();

const urlCanonica = `https://lp.brunomassa.online/${lp.slug}`;
---
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{d.headline}</title>
    <meta name="description" content={d.subheadline} />
    {rascunho && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={urlCanonica} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:title" content={d.headline} />
    <meta property="og:description" content={d.subheadline} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:image" content="https://brunomassa.online/images/bruno.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="lp">
    {rascunho && (
      <div class="rascunho-bar">RASCUNHO · visível só por link · troque para "publicado" quando estiver pronto</div>
    )}

    <!-- HERO -->
    <header class="hero">
      <div class="wrap hero-grid">
        <div class="hero-txt">
          <p class="selo">{d.selo}</p>
          <h1>{d.headline}</h1>
          <p class="sub">{d.subheadline}</p>
          <div class="chips">
            {(d.infoLinha ?? []).map((c: string) => <span class="chip">{c}</span>)}
          </div>
          <div class="hero-cta">
            <a href="#candidatar" class="btn">{d.ctaTexto}</a>
          </div>
          <p class="cta-nota">{d.ctaNota}</p>
        </div>
        <div class="hero-foto">
          <img src={d.fotoUrl} alt="Bruno Massa" />
        </div>
      </div>
    </header>

    <!-- ABERTURA (cena da rotina reativa) -->
    <section class="sec">
      <div class="wrap narrow">
        {(d.abertura ?? []).map((p: string) => <p class="lead">{p}</p>)}
        <p class="destaque">{d.aberturaDestaque}</p>
        <p class="lead">{d.aberturaFecho}</p>
      </div>
    </section>

    <!-- IDEIA DISTINTIVA (bloco escuro) -->
    <section class="sec dark">
      <div class="wrap narrow">
        <p class="tese">{d.ideiaDistintiva}</p>
      </div>
    </section>

    <!-- PARA QUEM É / NÃO É -->
    <section class="sec">
      <div class="wrap grid2">
        <div>
          <h2>Para quem é</h2>
          <ul class="lista sim">
            {(d.paraQuem ?? []).map((i: string) => <li>{i}</li>)}
          </ul>
          <p class="nota">{d.paraQuemNota}</p>
        </div>
        <div>
          <h2>Para quem não é</h2>
          <ul class="lista nao">
            {(d.paraQuemNao ?? []).map((i: string) => <li>{i}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- TRANSFORMAÇÃO: antes / depois + entregas -->
    <section class="sec papel-2">
      <div class="wrap">
        <p class="eyebrow">A transformação</p>
        <div class="grid2 ad">
          <div class="antes">
            <h3>Antes</h3>
            <ul class="lista">{(d.antes ?? []).map((i: string) => <li>{i}</li>)}</ul>
          </div>
          <div class="depois">
            <h3>Depois das quatro semanas</h3>
            <ul class="lista sim">{(d.depois ?? []).map((i: string) => <li>{i}</li>)}</ul>
          </div>
        </div>
        <p class="nota center">{d.transformacaoNota}</p>

        <div class="entregas">
          <p class="eyebrow center">Você termina com quatro evidências na mão</p>
          <div class="entregas-grid">
            {(d.entregas ?? []).map((e: string, i: number) => (
              <div class="entrega">
                <span class="num">{i + 1}</span>
                <p>{e}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- OS 4 ENCONTROS -->
    <section class="sec">
      <div class="wrap">
        <p class="eyebrow">O método em quatro encontros</p>
        <div class="encontros">
          {(d.encontros ?? []).map((e: any) => (
            <div class="encontro">
              <div class="e-head">
                <span class="e-num">Encontro {e.n}</span>
                <h3>{e.titulo}</h3>
                <p class="e-sub">{e.subtitulo}</p>
              </div>
              <p class="e-desc">{e.descricao}</p>
              <p class="e-app"><b>Aplicação da semana:</b> {e.aplicacao}</p>
              <div class="e-mats">
                {(e.materiais ?? []).map((m: string) => <span class="e-mat">{m}</span>)}
              </div>
            </div>
          ))}
        </div>
        <div class="como">
          <p class="eyebrow">Como funciona cada encontro (2 horas)</p>
          <ul class="lista">{(d.comoFunciona ?? []).map((i: string) => <li>{i}</li>)}</ul>
          <p class="nota">{d.comoFuncionaNota}</p>
        </div>
      </div>
    </section>

    <!-- DATAS E FORMATO -->
    {d.datas && (
      <section class="sec">
        <div class="wrap datas-wrap">
          <div class="datas-info">
            <p class="eyebrow">Datas e formato</p>
            <p class="datas-plat">{d.datas.plataforma}</p>
            <p class="datas-hora">{d.datas.diaSemana} · {d.datas.horario}</p>
          </div>
          <div class="datas-lista">
            {(d.datas.lista ?? []).map((dia: string, i: number) => (
              <div class="data-item"><span class="data-n">{i + 1}</span><span class="data-txt">{dia} <b>de {d.datas.ano}</b></span></div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- O QUE ESTÁ INCLUÍDO -->
    <section class="sec papel-2">
      <div class="wrap">
        <p class="eyebrow">O que está incluído</p>
        <ul class="incluido">
          {(d.incluido ?? []).map((i: string) => <li>{i}</li>)}
        </ul>
        {d.acesso && <p class="nota" style="margin-top:26px; max-width:64ch;">{d.acesso}</p>}
      </div>
    </section>

    <!-- COMO VOCÊ É ACOMPANHADO -->
    {Array.isArray(d.acompanhamento) && d.acompanhamento.length > 0 && (
      <section class="sec">
        <div class="wrap">
          <p class="eyebrow">Como você é acompanhado</p>
          <div class="acomp">
            {d.acompanhamento.map((a: any) => (
              <div class="acomp-item">
                <h3>{a.titulo}</h3>
                <p>{a.texto}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- BÔNUS: DUAS CONSULTORIAS -->
    {d.consultorias && (
      <section class="sec papel-2">
        <div class="wrap narrow">
          <p class="eyebrow">{d.consultorias.titulo}</p>
          <p class="lead sm">{d.consultorias.texto}</p>
          <p class="crit-titulo">A avaliação considera:</p>
          <ul class="criterios-lista">
            {(d.consultorias.criterios ?? []).map((crit: string) => <li>{crit}</li>)}
          </ul>
          {d.consultorias.empate && <p class="nota">{d.consultorias.empate}</p>}
          {d.consultorias.agendamento && <p class="nota">{d.consultorias.agendamento}</p>}
        </div>
      </section>
    )}

    <!-- QUEM CONDUZ -->
    <section class="sec dark">
      <div class="wrap grid-conduz">
        <div class="conduz-foto"><img src={d.quemConduz?.fotoUrl ?? d.fotoUrl} alt="Bruno Massa" /></div>
        <div>
          <p class="eyebrow verde">Quem conduz</p>
          {(d.quemConduz?.paragrafos ?? []).map((p: string) => <p class="conduz-p">{p}</p>)}
        </div>
      </div>
    </section>

    <!-- CONFIDENCIALIDADE + IA -->
    <section class="sec">
      <div class="wrap narrow">
        <h2>Confidencialidade e segurança</h2>
        {(d.confidencialidade ?? []).map((p: string) => <p class="lead sm">{p}</p>)}
        <p class="nota">{d.iaResponsavel}</p>
      </div>
    </section>

    <!-- DIAGNÓSTICO E SELEÇÃO -->
    {d.diagnostico && (
      <section class="sec dark">
        <div class="wrap narrow">
          <p class="eyebrow verde">Diagnóstico e seleção</p>
          {(d.diagnostico.paragrafos ?? []).map((p: string) => <p class="conduz-p">{p}</p>)}
          {Array.isArray(d.diagnostico.funcoes) && d.diagnostico.funcoes.length > 0 && (
            <ul class="diag-funcoes">
              {d.diagnostico.funcoes.map((f: string) => <li>{f}</li>)}
            </ul>
          )}
        </div>
      </section>
    )}

    <!-- INVESTIMENTO + ESCASSEZ -->
    <section class="sec papel-2">
      <div class="wrap narrow center">
        <p class="eyebrow center">{d.investimento?.headline}</p>
        <div class="preco-grande">{d.preco}</div>
        <p class="preco-sub">{d.precoNota}{d.parcelamento ? ` · ${d.parcelamento}` : ''}</p>
        <p class="lead sm">{d.investimento?.texto}</p>
        <p class="nota">{d.investimento?.nota}</p>
        <div class="escassez">{d.investimento?.escassez}</div>
        <a href="#candidatar" class="btn grande">{d.ctaTexto}</a>
      </div>
    </section>

    <!-- FAQ -->
    <section class="sec">
      <div class="wrap narrow">
        <p class="eyebrow">Perguntas frequentes</p>
        <div class="faq">
          {(d.faq ?? []).map((f: any) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- BLOCO FINAL + FORMULÁRIO DE CANDIDATURA -->
    <section class="sec dark" id="candidatar">
      <div class="wrap grid-final">
        <div>
          <h2 class="final-h">{d.blocoFinal?.headline}</h2>
          <p class="conduz-p">{d.blocoFinal?.texto}</p>
          <p class="resumo-final">{d.blocoFinal?.resumo}</p>
          <div class="preco-final"><b>{d.preco}</b> {d.precoNota}</div>
          <p class="micro">{d.blocoFinal?.micro}</p>
        </div>
        <div>
          <Candidatura client:load slug={lp.slug} ctaTexto={d.ctaTexto} />
        </div>
      </div>
    </section>

    <footer class="lp-foot">
      <div class="wrap">
        <p>© {anoAtual} Bruno Massa · Mente do Mercado</p>
        <p class="foot-links"><a href="https://brunomassa.online" target="_blank" rel="noopener">brunomassa.online</a> · <a href="https://brunomassa.online/privacidade" target="_blank" rel="noopener">Privacidade</a></p>
      </div>
    </footer>

    <style is:global>
      .lp {
        --preto: #0A0A0B; --papel: #ECECEA; --papel-2: #E3E3E0; --verde: #C2F03C;
        margin: 0; background: var(--papel); color: var(--preto);
        font-family: 'Hanken Grotesk', system-ui, -apple-system, sans-serif;
        line-height: 1.6; -webkit-font-smoothing: antialiased;
      }
      .lp .wrap { max-width: 1080px; margin: 0 auto; padding: 0 24px; }
      .lp .narrow { max-width: 720px; }
      .lp .center { text-align: center; }
      .lp .sec { padding: 72px 0; }
      .lp .papel-2 { background: var(--papel-2); }
      .lp .dark { background: var(--preto); color: var(--papel); }

      .rascunho-bar { background: var(--verde); color: #0A0A0B; text-align: center; font-size: 12px; font-weight: 700; padding: 8px; letter-spacing: .04em; text-transform: uppercase; }

      /* HERO */
      .lp .hero { background: var(--preto); color: var(--papel); padding: 64px 0 72px; }
      .lp .hero-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: 48px; align-items: center; }
      .lp .selo { font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--verde); margin: 0 0 20px; }
      .lp h1 { font-size: clamp(30px, 4.4vw, 52px); font-weight: 800; letter-spacing: -0.02em; line-height: 1.08; margin: 0 0 20px; }
      .lp .sub { font-size: clamp(16px, 2vw, 19px); color: rgba(236,236,234,.72); margin: 0 0 26px; max-width: 34ch; }
      .lp .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 28px; }
      .lp .chip { font-size: 12.5px; font-weight: 600; border: 1px solid rgba(236,236,234,.22); padding: 6px 12px; border-radius: 999px; color: rgba(236,236,234,.85); }
      .lp .hero-cta { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
      .lp .hero-preco { font-size: 15px; color: rgba(236,236,234,.7); }
      .lp .hero-preco b { color: var(--papel); font-size: 18px; }
      .lp .cta-nota { font-size: 12.5px; color: rgba(236,236,234,.45); margin: 14px 0 0; }
      .lp .hero-foto img { width: 100%; height: 100%; max-height: 440px; object-fit: cover; object-position: top; filter: grayscale(1) contrast(1.05); border-radius: 2px; }

      /* Botão (consistente em toda a página) */
      .lp .btn { display: inline-block; background: var(--verde); color: #0A0A0B; font-weight: 700; font-size: 15px; text-transform: uppercase; letter-spacing: .02em; padding: 15px 28px; text-decoration: none; border-radius: 2px; transition: opacity .2s; }
      .lp .btn:hover { opacity: .9; }
      .lp .btn.grande { font-size: 16px; padding: 18px 40px; margin-top: 28px; }

      /* Texto corrido */
      .lp .lead { font-size: 19px; margin: 0 0 18px; }
      .lp .lead.sm { font-size: 16px; color: #2a2a2c; }
      .lp .destaque { font-size: clamp(21px, 3vw, 28px); font-weight: 700; letter-spacing: -0.01em; line-height: 1.3; margin: 32px 0; padding-left: 20px; border-left: 4px solid var(--verde); }
      .lp .tese { font-size: clamp(22px, 3.2vw, 32px); font-weight: 700; line-height: 1.35; letter-spacing: -0.01em; text-align: center; margin: 0; }
      .lp .tese::before { content: ''; display: block; width: 40px; height: 4px; background: var(--verde); margin: 0 auto 28px; }

      .lp h2 { font-size: clamp(24px, 3vw, 32px); font-weight: 800; letter-spacing: -0.02em; margin: 0 0 22px; }
      .lp h3 { font-size: 19px; font-weight: 700; margin: 0 0 12px; }
      .lp .eyebrow { font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #6a6a6a; margin: 0 0 22px; }
      .lp .eyebrow.verde { color: var(--verde); }
      .lp .nota { font-size: 14.5px; color: #55555a; margin: 18px 0 0; }
      .lp .nota.center { text-align: center; max-width: 62ch; margin-left: auto; margin-right: auto; }

      .lp .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 44px; }
      .lp .lista { list-style: none; padding: 0; margin: 0; }
      .lp .lista li { position: relative; padding-left: 26px; margin-bottom: 11px; font-size: 15.5px; }
      .lp .lista li::before { content: '—'; position: absolute; left: 0; color: #9a9a9a; }
      .lp .lista.sim li::before { content: ''; position: absolute; left: 0; top: 9px; width: 12px; height: 12px; background: var(--verde); border-radius: 2px; }
      .lp .lista.nao li::before { content: '×'; color: #b0b0b0; font-weight: 700; }

      /* Antes/Depois */
      .lp .ad .antes { opacity: .72; }
      .lp .ad h3 { font-size: 15px; text-transform: uppercase; letter-spacing: .05em; color: #6a6a6a; }
      .lp .ad .depois h3 { color: #0A0A0B; }

      /* Entregas */
      .lp .entregas { margin-top: 56px; }
      .lp .entregas-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 22px; }
      .lp .entrega { background: var(--preto); color: var(--papel); padding: 24px 20px; border-radius: 2px; }
      .lp .entrega .num { display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; background: var(--verde); color: #0A0A0B; font-weight: 800; margin-bottom: 14px; border-radius: 2px; }
      .lp .entrega p { font-size: 14.5px; margin: 0; color: rgba(236,236,234,.9); }

      /* Encontros */
      .lp .encontros { display: grid; gap: 16px; }
      .lp .encontro { border: 1px solid rgba(10,10,11,.14); padding: 28px; border-radius: 2px; background: rgba(255,255,255,.35); }
      .lp .e-num { font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--verde); background: var(--preto); padding: 4px 10px; border-radius: 2px; }
      .lp .e-head h3 { margin: 14px 0 2px; font-size: 22px; }
      .lp .e-sub { font-size: 14px; color: #6a6a6a; margin: 0 0 14px; }
      .lp .e-desc { font-size: 15.5px; margin: 0 0 12px; }
      .lp .e-app { font-size: 15px; margin: 0 0 16px; }
      .lp .e-mats { display: flex; flex-wrap: wrap; gap: 7px; }
      .lp .e-mat { font-size: 12.5px; background: rgba(10,10,11,.06); padding: 5px 11px; border-radius: 999px; color: #3a3a3c; }
      .lp .como { margin-top: 48px; padding-top: 40px; border-top: 1px solid rgba(10,10,11,.12); }

      /* Incluído */
      .lp .incluido { list-style: none; padding: 0; margin: 0; columns: 2; column-gap: 44px; }
      .lp .incluido li { break-inside: avoid; padding-left: 24px; position: relative; margin-bottom: 11px; font-size: 15px; }
      .lp .incluido li::before { content: ''; position: absolute; left: 0; top: 8px; width: 10px; height: 10px; background: var(--verde); border-radius: 2px; }

      /* Quem conduz */
      .lp .grid-conduz { display: grid; grid-template-columns: .8fr 1.2fr; gap: 44px; align-items: center; }
      .lp .conduz-foto img { width: 100%; max-width: 320px; filter: grayscale(1) contrast(1.05); border-radius: 2px; }
      .lp .conduz-p { font-size: 16px; color: rgba(236,236,234,.8); margin: 0 0 16px; }

      /* Investimento */
      .lp .preco-grande { font-size: clamp(52px, 9vw, 84px); font-weight: 800; letter-spacing: -0.03em; line-height: 1; margin: 8px 0 4px; }
      .lp .preco-sub { font-size: 15px; color: #6a6a6a; margin: 0 0 28px; }
      .lp .escassez { font-size: 14.5px; color: #55555a; max-width: 60ch; margin: 24px auto 0; padding: 20px; border: 1px solid rgba(10,10,11,.14); border-radius: 2px; background: rgba(255,255,255,.4); }

      /* FAQ */
      .lp .faq details { border-bottom: 1px solid rgba(10,10,11,.14); padding: 4px 0; }
      .lp .faq summary { cursor: pointer; list-style: none; padding: 18px 0; font-size: 16.5px; font-weight: 600; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
      .lp .faq summary::-webkit-details-marker { display: none; }
      .lp .faq summary::after { content: '+'; color: var(--verde); font-size: 24px; font-weight: 700; line-height: 1; }
      .lp .faq details[open] summary::after { content: '–'; }
      .lp .faq details p { font-size: 15px; color: #45454a; margin: 0 0 20px; max-width: 64ch; }

      /* Bloco final */
      .lp .grid-final { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
      .lp .final-h { font-size: clamp(24px, 3.2vw, 34px); }
      .lp .resumo-final { font-size: 14px; color: var(--verde); font-weight: 600; letter-spacing: .02em; margin: 22px 0 16px; }
      .lp .preco-final { font-size: 16px; color: rgba(236,236,234,.7); }
      .lp .preco-final b { color: var(--papel); font-size: 22px; }
      .lp .micro { font-size: 12.5px; color: rgba(236,236,234,.45); margin: 12px 0 0; }

      /* Footer */
      .lp .lp-foot { background: var(--preto); color: rgba(236,236,234,.5); padding: 32px 0; font-size: 13px; }
      .lp .lp-foot .wrap { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; }
      .lp .lp-foot a { color: rgba(236,236,234,.7); text-decoration: none; }
      .lp .lp-foot a:hover { color: var(--verde); }

      /* Datas */
      .lp .datas-wrap { display: grid; grid-template-columns: .8fr 1.2fr; gap: 44px; align-items: center; }
      .lp .datas-plat { font-size: 22px; font-weight: 700; margin: 0 0 4px; }
      .lp .datas-hora { font-size: 15px; color: #55555a; margin: 0; }
      .lp .datas-lista { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
      .lp .data-item { display: flex; align-items: center; gap: 14px; background: rgba(255,255,255,.4); border: 1px solid rgba(10,10,11,.12); padding: 16px 18px; border-radius: 2px; }
      .lp .data-n { flex: none; width: 30px; height: 30px; display: grid; place-items: center; background: var(--verde); color: #0A0A0B; font-weight: 800; border-radius: 2px; }
      .lp .data-txt { font-size: 15.5px; font-weight: 500; }
      .lp .data-txt b { font-weight: 400; color: #6a6a6a; }

      /* Acompanhamento */
      .lp .acomp { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
      .lp .acomp-item { border: 1px solid rgba(10,10,11,.14); padding: 24px; border-radius: 2px; background: rgba(255,255,255,.35); }
