---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CalculadoraINK from '../components/CalculadoraINK.tsx';
export const prerender = false;
---
<BaseLayout
  title="Calculadora INK — Índice de Narrativa em KPI"
  descricao="Instrumento autoral do livro Narrativa em KPI, de Bruno Massa. Avalie o INK da sua marca em três componentes: reconhecimento, coerência e permanência."
>
  <Header />
  <CalculadoraINK client:load />
  <Footer />
</BaseLayout>

<style is:global>
  /* estilos da Calculadora INK (só carregam nesta página) */
  .font-serif { font-family: Georgia, 'Times New Roman', Times, serif; }
  @keyframes fadeInInk {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .fade-in-ink { animation: fadeInInk 0.5s ease-out; }
</style>
