---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { usarT, type Lang } from '../i18n';

const lang: Lang = Astro.locals.lang ?? 'pt';
const t = usarT(lang);

const amazonUrl = 'https://www.amazon.com.br/dp/B0DVZCQZP8?tag=lojadomassa-20';

// O livro é em português: o título é nome próprio e não se traduz.
const tituloLivro = 'Marketing na Era da Inteligência Artificial';

const publico = [t('livroPg.publico1'), t('livroPg.publico2'), t('livroPg.publico3'), t('livroPg.publico4')];
---
<BaseLayout title={tituloLivro} descricao={t('livroPg.metaDesc')}>
  <Header />
  <main>

    <!-- Hero do livro -->
    <section class="bg-white py-16 md:py-24">
      <div class="max-w-5xl mx-auto px-6">
        <div class="flex flex-col md:flex-row md:items-center gap-12">

          <!-- Capa -->
          <div class="flex-none mx-auto md:mx-0">
            <div class="w-48 md:w-56 rounded-2xl shadow-[0_20px_60px_rgba(0,0,0,0.18)] overflow-hidden">
              <img src="/images/livro-capa.jpg" alt={t('livroPg.capaAlt')} class="w-full h-full object-cover" />
            </div>
          </div>

          <!-- Texto -->
          <div class="flex-1">
            <p class="text-[12px] font-semibold uppercase tracking-[0.1em] text-apple-accent mb-4">{t('nav.livro')}</p>
            <h1 class="text-4xl md:text-5xl font-bold text-apple-label tracking-tight leading-tight mb-4 text-balance" lang="pt-BR">
              Marketing na Era da<br class="hidden md:block" /> Inteligência Artificial
            </h1>
            <p class="text-[18px] text-apple-secondary leading-relaxed mb-6 max-w-xl">
              {t('livroPg.subtitulo')}
            </p>
            <a
              href={amazonUrl}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 px-8 py-4 bg-[#FF9900] text-white rounded-full text-[16px] font-semibold transition-all duration-200 hover:bg-[#e68a00] hover:shadow-lg"
            >
              {t('livroPg.comprar')}
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </a>
            <p class="text-[13px] text-apple-tertiary mt-3">{t('livroPg.formato')}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Sobre o livro -->
    <section class="py-16">
      <div class="max-w-3xl mx-auto px-6 space-y-8">

        <div class="bg-apple-surface rounded-2xl shadow-card p-8">
          <h2 class="text-[22px] font-bold text-apple-label tracking-tight mb-4">{t('livroPg.sobre')}</h2>
          <div class="space-y-4 text-[16px] text-apple-secondary leading-relaxed">
            <p>{t('livroPg.p1')}</p>
            <p>{t('livroPg.p2')}</p>
            <p>{t('livroPg.p3')}</p>
          </div>
        </div>

        <div class="bg-apple-surface rounded-2xl shadow-card p-8">
          <h2 class="text-[22px] font-bold text-apple-label tracking-tight mb-4">{t('livroPg.paraQuem')}</h2>
          <ul class="space-y-3">
            {publico.map((item) => (
              <li class="flex items-start gap-3 text-[15px] text-apple-secondary">
                <span class="flex-none w-5 h-5 rounded-full bg-apple-accent/10 text-apple-accent text-[11px] font-bold flex items-center justify-center mt-0.5">✓</span>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-apple-surface rounded-2xl shadow-card p-8">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
            <div>
              <h2 class="text-[22px] font-bold text-apple-label tracking-tight mb-1">{t('livroPg.disponivel')}</h2>
              <p class="text-[15px] text-apple-secondary">{t('livroPg.disponivelSub')}</p>
            </div>
            <a
              href={amazonUrl}
              target="_blank"
              rel="noopener"
              class="flex-none inline-flex items-center gap-2 px-7 py-3.5 bg-[#FF9900] text-white rounded-full text-[15px] font-semibold transition-all duration-200 hover:bg-[#e68a00] hover:shadow-lg"
            >
              {t('home.livroCta')}
            </a>
          </div>
        </div>

      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>
