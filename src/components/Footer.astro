---
import { getIdentidade } from '../lib/content/collections';
import { getMenu } from '../lib/content/menus';
import { usarT, localizar, type Lang } from '../i18n';

const lang: Lang = Astro.locals.lang ?? 'pt';
const t = usarT(lang);
const id = (await getIdentidade(lang)).data;
const ano = new Date().getFullYear();

const fallback = [
  { href: '/timeline', label: t('timeline.titulo') },
  { href: '/projetos', label: t('projetos.titulo') },
  { href: '/skills', label: t('skills.titulo') },
  { href: '/palestras', label: t('nav.palestras') },
  { href: '/agora', label: t('agora.titulo') },
  { href: '/contato', label: t('contato.titulo') },
];
const dbMenu = await getMenu('rodape', lang);
const links = dbMenu.length ? dbMenu.map((i) => ({ href: i.url, label: i.label })) : fallback;
---
<footer class="bg-apple-fill border-t border-apple-separator-light mt-20">
  <div class="max-w-5xl mx-auto px-6 py-12">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
      <div>
        <p class="text-[15px] font-semibold text-apple-label">{id.nome}</p>
        <p class="text-[13px] text-apple-tertiary mt-0.5">{id.tagline}</p>
      </div>
      <nav aria-label={lang === 'en' ? 'Footer links' : 'Links do rodapé'}>
        <ul class="flex flex-wrap gap-x-6 gap-y-2">
          {links.map((l) => (
            <li>
              <a href={localizar(l.href, lang)} class="text-[13px] text-apple-secondary hover:text-apple-label transition-colors">{l.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="mt-8 pt-6 border-t border-apple-separator-light flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2">
      <p class="text-[12px] text-apple-tertiary">
        © {ano} {id.nome}. {t('rodape.assinatura')}
        <span class="mx-1 text-apple-separator">·</span>
        <a href={localizar('/privacidade', lang)} class="hover:text-apple-secondary hover:underline transition-colors">{t('rodape.privacidade')}</a>
        <span class="mx-1 text-apple-separator">·</span>
        <a href={localizar('/termos', lang)} class="hover:text-apple-secondary hover:underline transition-colors">{t('rodape.termos')}</a>
      </p>
      <div class="flex items-center gap-5">
        <a
          href="https://selo7.com.br"
          target="_blank"
          rel="noopener"
          title={t('rodape.agencia')}
          class="text-[12px] text-apple-secondary hover:text-apple-accent transition-colors"
        >
          {t('rodape.agencia')} ↗
        </a>
        {id.linkedin_url && (
          <a
            href={id.linkedin_url}
            target="_blank"
            rel="noopener"
            class="text-[12px] text-apple-secondary hover:text-apple-accent transition-colors"
          >
            LinkedIn ↗
          </a>
        )}
      </div>
    </div>
  </div>
</footer>
