---
const links = [
  { href: '/', label: 'Início' },
  { href: '/timeline', label: 'Trajetória' },
  { href: '/projetos', label: 'Projetos' },
  { href: '/skills', label: 'Skills' },
  { href: '/posts', label: 'Conteúdo' },
  { href: '/agora', label: 'Agora' },
  { href: '/contato', label: 'Contato' },
];

const pathname = Astro.url.pathname;
const ehAtual = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);
---
<header class="sticky top-0 z-50 nav-blur bg-white/80 border-b border-apple-separator/40 shadow-nav">
  <div class="max-w-5xl mx-auto px-6 h-12 flex items-center justify-between">
    <a href="/" class="text-[15px] font-semibold text-apple-label hover:text-apple-accent transition-colors duration-200">
      Bruno Massa
    </a>
    <nav aria-label="Menu principal">
      <ul class="flex items-center overflow-x-auto scrollbar-hide" style="scrollbar-width:none;-webkit-overflow-scrolling:touch;">
        {links.map((l) => (
          <li class="flex-none">
            <a
              href={l.href}
              aria-current={ehAtual(l.href) ? 'page' : undefined}
              class={`px-3 py-1.5 rounded-md text-[13px] transition-colors duration-200 whitespace-nowrap ${
                ehAtual(l.href)
                  ? 'text-apple-accent font-medium'
                  : 'text-apple-secondary hover:text-apple-label'
              }`}
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  nav ul::-webkit-scrollbar {
    display: none;
  }
</style>
